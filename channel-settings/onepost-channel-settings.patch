@@ -0,0 +1,207 @@
+const TITLE_LIMIT = 100;
+const TAGS_LIMIT = 500;
+const YOUTUBE_CATEGORIES = {
+  "1": "영화/애니메이션",
+  "2": "자동차",
+  "10": "음악",
+  "15": "반려동물",
+  "17": "스포츠",
+  "19": "여행/이벤트",
+  "20": "게임",
+  "22": "인물/블로그",
+  "23": "코미디",
+  "24": "엔터테인먼트",
+  "25": "뉴스/정치",
+  "26": "노하우/스타일",
+  "27": "교육",
+  "28": "과학기술",
+  "29": "비영리/사회운동",
+};
+const THREADS_REPLIES = {
+  everyone: "모두",
+  accounts_you_follow: "팔로우하는 계정",
+  mentioned_only: "멘션한 계정만",
+};
+
+function flag(value, fallback) {
+  if (value == null || value === "") return fallback;
+  const raw = String(value).trim().toLowerCase();
+  if (raw === "0" || raw === "false" || raw === "off" || value === false) return false;
+  if (raw === "1" || raw === "true" || raw === "on" || value === true) return true;
+  return fallback;
+}
+
+function cleanText(value, max) {
+  const text = String(value || "").replace(/\s+/g, " ").trim();
+  return max ? text.slice(0, max) : text;
+}
+
+function normalizeTags(raw) {
+  const parts = Array.isArray(raw) ? raw : String(raw || "").split(/[,，]/);
+  const tags = [];
+  let total = 0;
+  parts.forEach((part) => {
+    const tag = String(part || "").trim().replace(/^#+/, "");
+    if (!tag || tags.some((item) => item.toLowerCase() === tag.toLowerCase())) return;
+    const extra = (tags.length ? 1 : 0) + tag.length;
+    if (total + extra > TAGS_LIMIT) return;
+    tags.push(tag);
+    total += extra;
+  });
+  return tags;
+}
+
+function usernames(raw, limit) {
+  const parts = Array.isArray(raw) ? raw : String(raw || "").split(/[,，]/);
+  const names = [];
+  parts.forEach((part) => {
+    const name = String(part || "").trim().replace(/^@+/, "");
+    if (!/^[A-Za-z0-9._]{1,30}$/.test(name)) return;
+    if (names.some((item) => item.toLowerCase() === name.toLowerCase())) return;
+    if (names.length >= limit) return;
+    names.push(name);
+  });
+  return names;
+}
+
+function normalizeChannelSettings(raw) {
+  const src = raw && typeof raw === "object" ? raw : {};
+  const youtube = src.youtube && typeof src.youtube === "object" ? src.youtube : {};
+  const instagram = src.instagram && typeof src.instagram === "object" ? src.instagram : {};
+  const threads = src.threads && typeof src.threads === "object" ? src.threads : {};
+  const facebook = src.facebook && typeof src.facebook === "object" ? src.facebook : {};
+  const tiktok = src.tiktok && typeof src.tiktok === "object" ? src.tiktok : {};
+  const categoryId = YOUTUBE_CATEGORIES[String(youtube.categoryId || "22")] ? String(youtube.categoryId || "22") : "22";
+  const reply = THREADS_REPLIES[String(threads.replyControl || "everyone")] ? String(threads.replyControl || "everyone") : "everyone";
+  const license = youtube.license === "creativeCommon" ? "creativeCommon" : "youtube";
+  const madeForKids = String(youtube.madeForKids || "no") === "yes" ? "yes" : "no";
+  const thumbOffset = Number(instagram.thumbOffsetSec);
+  return {
+    youtube: {
+      synthetic: flag(youtube.synthetic, false),
+      tags: normalizeTags(youtube.tags).join(", "),
+      categoryId,
+      appendShorts: flag(youtube.appendShorts, true),
+      madeForKids,
+      notifySubscribers: flag(youtube.notifySubscribers, true),
+      license,
+      embeddable: flag(youtube.embeddable, true),
+    },
+    instagram: {
+      thumbOffsetSec: Number.isFinite(thumbOffset) && thumbOffset >= 0 ? Math.round(thumbOffset) : 0,
+      collaborators: usernames(instagram.collaborators, 3).join(", "),
+      shareToFeed: flag(instagram.shareToFeed, true),
+      audioName: cleanText(instagram.audioName, 100),
+    },
+    threads: {
+      replyControl: reply,
+      topicTag: cleanText(String(threads.topicTag || "").replace(/^#+/, ""), 50),
+    },
+    facebook: {
+      title: cleanText(facebook.title, 255),
+    },
+    tiktok: {
+      isAigc: flag(tiktok.isAigc, false),
+    },
+  };
+}
+
+function buildYoutubeTitle(input) {
+  const source = input || {};
+  const seconds = Number(source.durationSec);
+  const isShort = Number.isFinite(seconds) && seconds > 0 && seconds <= 60;
+  const needShorts = source.appendShorts !== false && isShort && !/#shorts\b/i.test(String(source.title || ""));
+  let base = cleanText(source.title, 0);
+  const reserved = needShorts ? " #shorts".length : 0;
+  if (base.length + reserved > TITLE_LIMIT) base = base.slice(0, Math.max(0, TITLE_LIMIT - reserved)).trimEnd();
+  let out = base;
+  normalizeTags(source.tags).slice(0, 3).forEach((tag) => {
+    const hash = "#" + tag.replace(/\s+/g, "");
+    if (!hash || out.toLowerCase().includes(hash.toLowerCase())) return;
+    const candidate = (out ? out + " " : "") + hash;
+    if (candidate.length + reserved > TITLE_LIMIT) return;
+    out = candidate;
+  });
+  if (needShorts) out = (out ? out + " " : "") + "#shorts";
+  return out.slice(0, TITLE_LIMIT);
+}
+
+function buildYoutubeDescription(input) {
+  const original = String((input && input.description) || "");
+  const seconds = Number(input && input.durationSec);
+  const isShort = Number.isFinite(seconds) && seconds > 0 && seconds <= 60;
+  if (!isShort || input.appendShorts === false) return original;
+  const cleaned = original.replace(/[ \t]*#shorts\b/gi, "").replace(/[ \t]+\n/g, "\n").trim();
+  return cleaned ? cleaned + "\n#shorts" : "#shorts";
+}
+
+function buildPlatformPayloads(settings, context) {
+  const safe = normalizeChannelSettings(settings);
+  const ctx = context || {};
+  const files = ctx.extraFiles || {};
+  const youtubeTitle = buildYoutubeTitle({
+    title: ctx.title,
+    tags: safe.youtube.tags,
+    durationSec: ctx.durationSec,
+    appendShorts: safe.youtube.appendShorts,
+  });
+  const youtubeDescription = buildYoutubeDescription({
+    description: ctx.caption,
+    durationSec: ctx.durationSec,
+    appendShorts: safe.youtube.appendShorts,
+  });
+  const youtube = {
+    snippet: {
+      title: youtubeTitle,
+      description: youtubeDescription,
+      tags: normalizeTags(safe.youtube.tags),
+      categoryId: safe.youtube.categoryId,
+      defaultLanguage: "ko",
+      defaultAudioLanguage: "ko",
+    },
+    status: {
+      containsSyntheticMedia: safe.youtube.synthetic === true,
+      selfDeclaredMadeForKids: safe.youtube.madeForKids === "yes",
+      embeddable: safe.youtube.embeddable !== false,
+      license: safe.youtube.license,
+    },
+    notifySubscribers: safe.youtube.notifySubscribers !== false,
+  };
+  if (files.youtubeThumbnail && files.youtubeThumbnail.storedName) {
+    youtube.thumbnail = { storedName: String(files.youtubeThumbnail.storedName) };
+  }
+  const instagram = {
+    share_to_feed: safe.instagram.shareToFeed !== false,
+    collaborators: usernames(safe.instagram.collaborators, 3),
+    audio_name: safe.instagram.audioName,
+  };
+  if (files.instagramCover && files.instagramCover.storedName) {
+    instagram.coverStoredName = String(files.instagramCover.storedName);
+  } else if (safe.instagram.thumbOffsetSec > 0) {
+    instagram.thumb_offset = safe.instagram.thumbOffsetSec;
+  }
+  const facebook = {
+    title: safe.facebook.title || cleanText(ctx.title, 255),
+    description: String(ctx.caption || ""),
+  };
+  if (files.facebookThumbnail && files.facebookThumbnail.storedName) {
+    facebook.thumbnailStoredName = String(files.facebookThumbnail.storedName);
+  }
+  const threads = {
+    reply_control: safe.threads.replyControl,
+  };
+  if (safe.threads.topicTag) threads.topic_tag = safe.threads.topicTag;
+  const tiktok = { is_aigc: safe.tiktok.isAigc === true };
+  return { youtube, instagram, facebook, threads, tiktok };
+}
+
+module.exports = {
+  TITLE_LIMIT,
+  YOUTUBE_CATEGORIES,
+  THREADS_REPLIES,
+  normalizeTags,
+  normalizeChannelSettings,
+  buildYoutubeTitle,
+  buildYoutubeDescription,
+  buildPlatformPayloads,
+};
