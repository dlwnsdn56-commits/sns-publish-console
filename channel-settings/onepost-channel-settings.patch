diff -u -r -N a/lib/channel-defaults.js b/lib/channel-defaults.js
--- a/lib/channel-defaults.js	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/channel-defaults.js	2026-11-13 09:36:08.546821821 +0000
@@ -0,0 +1,76 @@
+const fs = require("fs");
+const path = require("path");
+
+function defaultsFile(rootDir) {
+  return path.join(rootDir || process.cwd(), "data", "channel-defaults.json");
+}
+
+function recordKey(input) {
+  const clientId = String((input && input.clientId) || "").trim();
+  const channelId = String((input && input.channelId) || "").trim().toLowerCase();
+  const accountId = String((input && input.accountId) || "").trim();
+  return clientId + "\u001f" + channelId + "\u001f" + accountId;
+}
+
+function emptyStore() {
+  return { version: 1, records: {} };
+}
+
+function readStore(file) {
+  try {
+    const parsed = JSON.parse(fs.readFileSync(file, "utf8"));
+    if (!parsed || typeof parsed !== "object" || !parsed.records || typeof parsed.records !== "object") {
+      return emptyStore();
+    }
+    return { version: 1, records: parsed.records };
+  } catch {
+    return emptyStore();
+  }
+}
+
+function writeStore(file, store) {
+  fs.mkdirSync(path.dirname(file), { recursive: true });
+  const tmp = file + ".tmp";
+  fs.writeFileSync(tmp, JSON.stringify({ version: 1, records: store.records || {} }, null, 2));
+  fs.renameSync(tmp, file);
+}
+
+function listDefaults(file, clientId) {
+  const store = readStore(file);
+  const want = String(clientId || "").trim();
+  return Object.values(store.records).filter((row) => row && row.clientId === want);
+}
+
+function getDefault(file, input) {
+  const store = readStore(file);
+  return store.records[recordKey(input)] || null;
+}
+
+function putDefault(file, input) {
+  const clientId = String((input && input.clientId) || "").trim();
+  const channelId = String((input && input.channelId) || "").trim().toLowerCase();
+  if (!clientId || !channelId) {
+    throw new Error("가게와 채널이 필요합니다.");
+  }
+  const accountId = String((input && input.accountId) || "").trim();
+  const store = readStore(file);
+  const row = {
+    clientId,
+    channelId,
+    accountId,
+    settings: input.settings && typeof input.settings === "object" ? input.settings : {},
+    updatedAt: new Date().toISOString(),
+  };
+  store.records[recordKey(row)] = row;
+  writeStore(file, store);
+  return row;
+}
+
+module.exports = {
+  defaultsFile,
+  recordKey,
+  readStore,
+  listDefaults,
+  getDefault,
+  putDefault,
+};
diff -u -r -N a/lib/channel-defaults-routes.js b/lib/channel-defaults-routes.js
--- a/lib/channel-defaults-routes.js	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/channel-defaults-routes.js	2026-11-13 09:36:08.546821821 +0000
@@ -0,0 +1,46 @@
+const { defaultsFile, listDefaults, putDefault } = require("./channel-defaults");
+const { normalizeChannelSettings } = require("./channel-settings");
+
+function emailOf(req) {
+  const session = req && req.session;
+  const user = (session && session.user) || (req && req.user) || {};
+  return String((session && session.email) || user.email || "").trim().toLowerCase();
+}
+
+function mountChannelDefaults(app, opts) {
+  const options = opts || {};
+  const file = options.file || defaultsFile(options.rootDir);
+  app.get("/api/channel-defaults", (req, res) => {
+    const email = emailOf(req);
+    if (!email) return res.status(401).json({ error: "로그인이 필요합니다." });
+    const clientId = String(req.query.clientId || "").trim();
+    if (options.getClient && !options.getClient(email, clientId)) {
+      return res.status(404).json({ error: "가게를 찾지 못했습니다." });
+    }
+    res.json({ defaults: listDefaults(file, clientId) });
+  });
+  app.put("/api/channel-defaults", (req, res) => {
+    const email = emailOf(req);
+    if (!email) return res.status(401).json({ error: "로그인이 필요합니다." });
+    const body = req.body || {};
+    const clientId = String(body.clientId || "").trim();
+    if (options.getClient && !options.getClient(email, clientId)) {
+      return res.status(404).json({ error: "가게를 찾지 못했습니다." });
+    }
+    try {
+      const channelId = String(body.channelId || "").toLowerCase();
+      const saved = putDefault(file, {
+        clientId,
+        channelId,
+        accountId: body.accountId,
+        settings: normalizeChannelSettings({ [channelId]: body.settings || {} })[channelId] || {},
+      });
+      res.json({ ok: true, saved });
+    } catch (err) {
+      res.status(400).json({ error: "기본값을 저장하지 못했습니다." });
+    }
+  });
+  return app;
+}
+
+module.exports = { mountChannelDefaults };
diff -u -r -N a/lib/channel-settings.js b/lib/channel-settings.js
--- a/lib/channel-settings.js	1970-01-01 00:00:00.000000000 +0000
