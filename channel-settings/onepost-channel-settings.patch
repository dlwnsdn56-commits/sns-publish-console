diff -u -r -N a/test/channel-settings.test.js b/test/channel-settings.test.js
--- a/test/channel-settings.test.js	1970-01-01 00:00:00.000000000 +0000
+++ b/test/channel-settings.test.js	2026-11-13 09:36:08.546821821 +0000
@@ -0,0 +1,110 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("fs");
+const os = require("os");
+const path = require("path");
+const { putDefault, getDefault, listDefaults } = require("../lib/channel-defaults");
+const { buildPlatformPayloads, buildYoutubeTitle, TITLE_LIMIT } = require("../lib/channel-settings");
+const { createPublishJob } = require("../lib/publish-job");
+
+function deps(extra) {
+  return Object.assign({
+    getClient: () => ({ id: "shop", name: "가게" }),
+    getChannel: (id) => ({ id, name: id, kind: "api" }),
+    isRpaKind: () => false,
+    resolvePlan: () => ({ isPaid: true, usedThisMonth: 0, freeLimit: 10, planId: "starter" }),
+    store: {
+      parseSeoulLocalDateTime: () => null,
+      isScheduleTooFar: () => false,
+      isFutureSeoulLocal: () => false,
+      addJob: () => null,
+      RPA_STATUS_QUEUED: "대기",
+    },
+  }, extra || {});
+}
+
+const files = [{ originalName: "a.mp4", storedName: "a.mp4", mimeType: "video/mp4", size: 10 }];
+
+test("defaults stay per store and per connected account", () => {
+  const file = path.join(os.tmpdir(), "onepost-defaults-" + Date.now() + ".json");
+  putDefault(file, { clientId: "shop-a", channelId: "youtube", accountId: "acc-1", settings: { tags: "김치" } });
+  putDefault(file, { clientId: "shop-a", channelId: "youtube", accountId: "acc-2", settings: { tags: "서울" } });
+  putDefault(file, { clientId: "shop-b", channelId: "youtube", accountId: "acc-1", settings: { tags: "부산" } });
+  assert.equal(getDefault(file, { clientId: "shop-a", channelId: "youtube", accountId: "acc-1" }).settings.tags, "김치");
+  assert.equal(getDefault(file, { clientId: "shop-a", channelId: "youtube", accountId: "acc-2" }).settings.tags, "서울");
+  assert.equal(listDefaults(file, "shop-b")[0].settings.tags, "부산");
+  fs.unlinkSync(file);
+});
+
+test("youtube title keeps shorts and tags inside 100 chars and synthetic stays off", () => {
+  const payload = buildPlatformPayloads({
+    youtube: { tags: "김치, 서울, 브이로그, 네번째", synthetic: false, appendShorts: true, categoryId: "26" },
+  }, { title: "맛집", caption: "설명", durationSec: 40 }).youtube;
+  assert.equal(payload.snippet.title.endsWith("#shorts"), true);
+  assert.equal(payload.snippet.title.includes("#김치"), true);
+  assert.equal(payload.snippet.title.includes("#네번째"), false);
+  assert.equal(payload.snippet.title.length <= TITLE_LIMIT, true);
+  assert.equal(payload.snippet.description.endsWith("#shorts"), true);
+  assert.equal((payload.snippet.description.match(/#shorts/gi) || []).length, 1);
+  assert.equal(payload.snippet.defaultLanguage, "ko");
+  assert.equal(payload.snippet.defaultAudioLanguage, "ko");
+  assert.equal(payload.snippet.categoryId, "26");
+  assert.equal(payload.status.containsSyntheticMedia, false);
+  assert.equal(Object.prototype.hasOwnProperty.call(payload.status, "privacyStatus"), false);
+  const trimmed = buildYoutubeTitle({ title: "가".repeat(100), tags: "태그", durationSec: 30, appendShorts: true });
+  assert.equal(trimmed.length <= 100, true);
+  assert.equal(trimmed.endsWith("#shorts"), true);
+  assert.equal(trimmed.includes("#태그"), false);
+});
+
+test("instagram collaborators and cover, tiktok ai flag", () => {
+  const ig = buildPlatformPayloads({
+    instagram: { collaborators: "@cafe, bad name, shop, third, fourth", shareToFeed: true, audioName: "원본", thumbOffsetSec: 3 },
+  }, { extraFiles: { instagramCover: { storedName: "cover.jpg" } } }).instagram;
+  assert.deepEqual(ig.collaborators, ["cafe", "shop", "third"]);
+  assert.equal(ig.share_to_feed, true);
+  assert.equal(ig.audio_name, "원본");
+  assert.equal(ig.coverStoredName, "cover.jpg");
+  assert.equal(ig.thumb_offset, undefined);
+  const offset = buildPlatformPayloads({ instagram: { thumbOffsetSec: 2, shareToFeed: false } }).instagram;
+  assert.equal(offset.thumb_offset, 2);
+  assert.equal(offset.share_to_feed, false);
+  const tiktok = buildPlatformPayloads({ tiktok: { isAigc: true } }).tiktok;
+  assert.equal(tiktok.is_aigc, true);
+  const threads = buildPlatformPayloads({ threads: { replyControl: "mentioned_only", topicTag: "#맛집" } }).threads;
+  assert.equal(threads.reply_control, "mentioned_only");
+  assert.equal(threads.topic_tag, "맛집");
+});
+
+test("publish job saves defaults and keeps the synthetic flag opt-in", () => {
+  const file = path.join(os.tmpdir(), "onepost-job-defaults-" + Date.now() + ".json");
+  const result = createPublishJob({
+    email: "owner@example.test",
+    dryRun: true,
+    body: {
+      clientId: "shop",
+      mediaType: "video",
+      channels: ["youtube", "instagram", "tiktok"],
+      title: "맛집",
+      caption: "설명",
+      youtubeDurationSec: 20,
+      channelSettings: {
+        youtube: { synthetic: false, tags: "김치", appendShorts: true },
+        instagram: { collaborators: "cafe", shareToFeed: true },
+        tiktok: { isAigc: true },
+      },
+      saveChannelDefaults: { youtube: true, instagram: true },
+      channelAccounts: { youtube: "acc-1" },
+      tiktokOptions: { privacyLevel: "PUBLIC_TO_EVERYONE", isAigc: true },
+    },
+    files,
+  }, deps({ defaultsFile: file }));
+  assert.equal(result.ok, true);
+  assert.equal(result.job.youtubeSynthetic, false);
+  assert.equal(result.job.platformPayloads.youtube.status.privacyStatus, undefined);
+  assert.equal(result.tasks.find((task) => task.channel === "youtube").caption, "설명");
+  assert.equal(result.job.tiktokOptions.isAigc, true);
+  assert.equal(getDefault(file, { clientId: "shop", channelId: "youtube", accountId: "acc-1" }).settings.tags, "김치");
+  assert.equal(getDefault(file, { clientId: "shop", channelId: "instagram", accountId: "" }).settings.collaborators, "cafe");
+  fs.unlinkSync(file);
+});
