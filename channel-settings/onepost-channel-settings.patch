+(function () {
+  let client = null;
+  let saved = [];
+  let loadedFor = "";
+  const touched = {};
+
+  function selected() {
+    return new Set(
+      Array.from(document.querySelectorAll("input[name=compose-channel]:checked")).map((el) => el.value)
+    );
+  }
+
+  function accountId(channelId) {
+    const connections = client && client.connections;
+    const row = connections && connections[channelId];
+    const account = row && (row.account || row);
+    return String((account && (account.id || account.openId || account.username)) || "");
+  }
+
+  function savedRow(channelId) {
+    const account = accountId(channelId);
+    return saved.find((row) => row.channelId === channelId && String(row.accountId || "") === account) || null;
+  }
+
+  function setChecked(id, value) {
+    const el = document.getElementById(id);
+    if (el && !touched[id]) el.checked = !!value;
+  }
+
+  function setValue(id, value) {
+    const el = document.getElementById(id);
+    if (el && !touched[id]) el.value = value == null ? "" : String(value);
+  }
+
+  function markState(id, row) {
+    const el = document.getElementById(id);
+    if (!el) return;
+    el.textContent = row
+      ? "저장된 기본값을 채웠습니다."
+      : "처음 설정입니다. 켜 두면 다음 올리기에 이 값이 채워집니다.";
+  }
+
+  function applySaved() {
+    const youtube = savedRow("youtube");
+    const yt = (youtube && youtube.settings) || {};
+    setChecked("yt-synthetic", yt.synthetic === true);
+    setValue("yt-tags", yt.tags || "");
+    setValue("yt-category", yt.categoryId || "22");
+    setChecked("yt-shorts", yt.appendShorts !== false);
+    setValue("yt-kids", yt.madeForKids === "yes" ? "yes" : "no");
+    setChecked("yt-notify", yt.notifySubscribers !== false);
+    setValue("yt-license", yt.license === "creativeCommon" ? "creativeCommon" : "youtube");
+    setChecked("yt-embed", yt.embeddable !== false);
+    setChecked("yt-save", true);
+    markState("yt-default-state", youtube);
+
+    const instagram = savedRow("instagram");
+    const ig = (instagram && instagram.settings) || {};
+    setValue("ig-thumb-sec", ig.thumbOffsetSec || 0);
+    setValue("ig-collaborators", ig.collaborators || "");
+    setChecked("ig-share", ig.shareToFeed !== false);
+    setValue("ig-audio", ig.audioName || "");
+    setChecked("ig-save", true);
+    markState("ig-default-state", instagram);
+
+    const threads = savedRow("threads");
+    const th = (threads && threads.settings) || {};
+    setValue("th-reply", th.replyControl || "everyone");
+    setValue("th-topic", th.topicTag || "");
+    setChecked("th-save", true);
+    markState("th-default-state", threads);
+
+    const facebook = savedRow("facebook");
+    const fb = (facebook && facebook.settings) || {};
+    setValue("fb-title", fb.title || "");
+    setChecked("fb-save", true);
+    markState("fb-default-state", facebook);
+
+    const tiktok = savedRow("tiktok");
+    const tt = (tiktok && tiktok.settings) || {};
+    setChecked("tiktok-aigc", tt.isAigc === true);
+    setChecked("tiktok-save-default", true);
+    markState("tiktok-default-state", tiktok);
+  }
+
+  async function load(clientId) {
+    if (!clientId) {
+      saved = [];
+      loadedFor = "";
+      applySaved();
+      return;
+    }
+    if (loadedFor === clientId) return;
+    loadedFor = clientId;
+    try {
+      const res = await fetch("/api/channel-defaults?clientId=" + encodeURIComponent(clientId));
+      const data = await res.json().catch(() => ({}));
+      saved = res.ok && Array.isArray(data.defaults) ? data.defaults : [];
+    } catch {
+      saved = [];
+    }
+    applySaved();
+  }
+
+  function refresh() {
+    const picks = selected();
+    document.querySelectorAll(".channel-native-card").forEach((card) => {
+      card.hidden = !picks.has(card.getAttribute("data-channel"));
+    });
+    const plain = document.getElementById("channel-native-plain");
+    if (plain) plain.hidden = !(picks.has("x") || picks.has("naver-clip"));
+    const shop = document.getElementById("client-shop");
+    const clientId = (client && client.id) || (shop && shop.value) || "";
+    load(clientId);
+  }
+
+  function checked(id) {
+    const el = document.getElementById(id);
+    return !!(el && el.checked);
+  }
+
+  function value(id) {
+    const el = document.getElementById(id);
+    return el ? el.value : "";
+  }
+
+  function collect() {
+    const settings = {
+      youtube: {
+        synthetic: checked("yt-synthetic"),
+        tags: value("yt-tags"),
+        categoryId: value("yt-category") || "22",
+        appendShorts: checked("yt-shorts"),
+        madeForKids: value("yt-kids") || "no",
+        notifySubscribers: checked("yt-notify"),
+        license: value("yt-license") || "youtube",
+        embeddable: checked("yt-embed"),
+      },
+      instagram: {
+        thumbOffsetSec: Number(value("ig-thumb-sec")) || 0,
+        collaborators: value("ig-collaborators"),
+        shareToFeed: checked("ig-share"),
+        audioName: value("ig-audio"),
+      },
+      threads: {
+        replyControl: value("th-reply") || "everyone",
+        topicTag: value("th-topic"),
+      },
+      facebook: { title: value("fb-title") },
+      tiktok: { isAigc: checked("tiktok-aigc") },
+    };
+    const save = {
+      youtube: checked("yt-save"),
+      instagram: checked("ig-save"),
+      threads: checked("th-save"),
+      facebook: checked("fb-save"),
+      tiktok: checked("tiktok-save-default"),
+    };
+    const accounts = {
+      youtube: accountId("youtube"),
+      instagram: accountId("instagram"),
+      threads: accountId("threads"),
+      facebook: accountId("facebook"),
+      tiktok: accountId("tiktok"),
+    };
+    return { settings, save, accounts };
+  }
+
+  document.addEventListener("input", (event) => {
+    const id = event.target && event.target.id;
+    if (id) touched[id] = true;
+  });
+  document.addEventListener("change", (event) => {
+    const id = event.target && event.target.id;
+    if (id) touched[id] = true;
+    if (event.target && event.target.name === "compose-channel") refresh();
+  });
+
+  window.OnepostChannelSettings = {
+    setClient(next) {
+      const nextId = next && next.id;
+      if (!client || client.id !== nextId) {
+        client = next || null;
+        loadedFor = "";
+        Object.keys(touched).forEach((key) => delete touched[key]);
+      } else {
+        client = next || null;
+      }
+      refresh();
+    },
+    refresh,
+    collect,
+  };
+})();
