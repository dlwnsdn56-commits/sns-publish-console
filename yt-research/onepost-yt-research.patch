@@ -0,0 +1,527 @@
+const fs = require("fs");
+const path = require("path");
+
+const SEARCH_TTL_MS = 12 * 60 * 60 * 1000;
+const STATS_TTL_MS = 24 * 60 * 60 * 1000;
+const DAILY_QUOTA = 10000;
+const QUOTA_STOP = 9500;
+const SEARCH_COST = 100;
+const LIST_COST = 1;
+const USER_SEARCH_LIMIT = 8;
+const USER_CHANNEL_LIMIT = 12;
+const OUTLIER_RATIO = 3;
+const SAMPLE_SIZE = 15;
+const QUOTA_MESSAGE = "오늘 유튜브에서 받아올 수 있는 횟수를 모두 썼습니다. 내일 다시 이용해 주세요.";
+const USER_LIMIT_MESSAGE = "오늘 이 계정으로 찾을 수 있는 횟수를 모두 썼습니다. 내일 다시 이용해 주세요.";
+
+function researchEnabled(env) {
+  return String((env || process.env).YT_RESEARCH_ENABLED || "") === "1";
+}
+
+function kstDay(date) {
+  return new Date(date.getTime() + 9 * 60 * 60 * 1000).toISOString().slice(0, 10);
+}
+
+function isoDurationSeconds(iso) {
+  const match = /^PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?$/.exec(String(iso || ""));
+  if (!match) return null;
+  return Number(match[1] || 0) * 3600 + Number(match[2] || 0) * 60 + Number(match[3] || 0);
+}
+
+function performanceScore(views, subscribers, hidden) {
+  const subs = Number(subscribers);
+  if (hidden || !Number.isFinite(subs) || subs <= 0) return null;
+  const count = Number(views);
+  if (!Number.isFinite(count) || count < 0) return null;
+  return Math.round((count / subs) * 10) / 10;
+}
+
+function outliersFrom(videos) {
+  const sample = (videos || []).filter((item) => Number.isFinite(Number(item.viewCount)));
+  if (!sample.length) return { averageViews: null, outliers: [] };
+  const total = sample.reduce((sum, item) => sum + Number(item.viewCount), 0);
+  const average = total / sample.length;
+  const outliers = sample.length < 2 ? [] : sample
+    .filter((item) => {
+      const others = (total - Number(item.viewCount)) / (sample.length - 1);
+      return others > 0 && Number(item.viewCount) >= others * OUTLIER_RATIO;
+    })
+    .map((item) => {
+      const others = (total - Number(item.viewCount)) / (sample.length - 1);
+      return Object.assign({}, item, { multiple: Math.round((Number(item.viewCount) / others) * 10) / 10 });
+    })
+    .sort((a, b) => Number(b.viewCount) - Number(a.viewCount));
+  return { averageViews: Math.round(average), outliers };
+}
+
+function uploadLabel(videos) {
+  const times = (videos || [])
+    .map((item) => Date.parse(item.publishedAt || ""))
+    .filter((item) => Number.isFinite(item))
+    .sort((a, b) => a - b);
+  if (times.length < 2) {
+    return { uploadEveryDays: null, uploadLabel: "최근 영상이 적어 올리는 간격을 계산하지 못했습니다." };
+  }
+  const gaps = [];
+  for (let i = 1; i < times.length; i += 1) gaps.push((times[i] - times[i - 1]) / 86400000);
+  gaps.sort((a, b) => a - b);
+  const days = Math.round(gaps[Math.floor(gaps.length / 2)] * 10) / 10;
+  return {
+    uploadEveryDays: days,
+    uploadLabel: days < 1 ? "거의 매일 올립니다" : "약 " + days + "일에 한 편",
+  };
+}
+
+function parseChannelInput(raw) {
+  const text = String(raw || "").trim();
+  if (!text) {
+    const err = new Error("채널 주소를 입력해 주세요.");
+    err.status = 400;
+    throw err;
+  }
+  let url = null;
+  try {
+    url = new URL(text);
+  } catch (_err) {
+    url = null;
+  }
+  if (url) {
+    const host = url.hostname.replace(/^www\./, "");
+    if (host !== "youtube.com" && host !== "m.youtube.com" && host !== "youtu.be") {
+      const err = new Error("유튜브 채널 주소만 넣을 수 있습니다.");
+      err.status = 400;
+      throw err;
+    }
+    const parts = url.pathname.split("/").filter(Boolean);
+    if (parts[0] === "channel" && parts[1]) return { id: parts[1] };
+    if (parts[0] && parts[0].startsWith("@")) return { handle: decodeURIComponent(parts[0].slice(1)).toLowerCase() };
+    if (parts[0] === "c" || parts[0] === "user" || parts[0] === "watch") {
+      const err = new Error("채널 주소는 @이름 또는 youtube.com/channel/ 주소로 넣어 주세요.");
+      err.status = 400;
+      throw err;
+    }
+  }
+  if (text.startsWith("@")) return { handle: text.slice(1).toLowerCase() };
+  if (/^UC[\w-]{20,}$/.test(text)) return { id: text };
+  if (/^[\w.\-]{2,80}$/.test(text)) return { handle: text.toLowerCase() };
+  const err = new Error("채널 주소를 확인해 주세요.");
+  err.status = 400;
+  throw err;
+}
+
+function createYtStore(options) {
+  const file = (options && options.file) || path.join(process.cwd(), "data", "yt-research-cache.json");
+  let cached = null;
+  function empty() {
+    return { cache: {}, usage: {}, quota: {} };
+  }
+  function load() {
+    if (cached) return cached;
+    try {
+      cached = JSON.parse(fs.readFileSync(file, "utf8"));
+    } catch (err) {
+      if (!err || err.code !== "ENOENT") throw err;
+      cached = empty();
+    }
+    cached.cache = cached.cache || {};
+    cached.usage = cached.usage || {};
+    cached.quota = cached.quota || {};
+    return cached;
+  }
+  function save() {
+    fs.mkdirSync(path.dirname(file), { recursive: true });
+    const tmp = file + "." + process.pid + ".tmp";
+    fs.writeFileSync(tmp, JSON.stringify(load()));
+    fs.renameSync(tmp, file);
+  }
+  return { load, save, file };
+}
+
+function createYtResearch(options) {
+  const opts = options || {};
+  const env = opts.env || process.env;
+  const store = opts.store || createYtStore(opts);
+  const nowFn = opts.now || (() => new Date());
+  const fetchImpl = opts.fetch || global.fetch;
+
+  function fail(status, message) {
+    const err = new Error(message);
+    err.status = status;
+    throw err;
+  }
+
+  function apiKey() {
+    const key = String(env.YOUTUBE_API_KEY || "");
+    if (!key) fail(503, "유튜브 연결 키가 설정되지 않았습니다. 관리자에게 알려 주세요.");
+    return key;
+  }
+
+  function dayBook() {
+    const day = kstDay(nowFn());
+    const quota = store.load().quota;
+    if (!quota[day]) quota[day] = { used: 0, exhausted: false };
+    return quota[day];
+  }
+
+  function markExhausted() {
+    const book = dayBook();
+    book.exhausted = true;
+    store.save();
+  }
+
+  function spend(cost) {
+    const book = dayBook();
+    if (book.exhausted || book.used + cost > QUOTA_STOP) {
+      book.exhausted = true;
+      store.save();
+      fail(429, QUOTA_MESSAGE);
+    }
+    book.used += cost;
+    store.save();
+  }
+
+  function takeUser(email, field, limit) {
+    const day = kstDay(nowFn());
+    const id = String(email || "").trim().toLowerCase();
+    const usage = store.load().usage;
+    if (!usage[id]) usage[id] = {};
+    if (!usage[id][day]) usage[id][day] = { search: 0, channel: 0 };
+    if (usage[id][day][field] >= limit) fail(429, USER_LIMIT_MESSAGE);
+    usage[id][day][field] += 1;
+    store.save();
+  }
+
+  function cacheGet(key, ttl) {
+    const row = store.load().cache[key];
+    if (!row) return null;
+    if (nowFn().getTime() - Date.parse(row.at) > ttl) return null;
+    return row.value;
+  }
+
+  function cacheSet(key, value) {
+    store.load().cache[key] = { at: nowFn().toISOString(), value };
+    store.save();
+  }
+
+  async function yt(methodPath, params) {
+    const url = new URL("https://www.googleapis.com/youtube/v3/" + methodPath);
+    Object.keys(params || {}).forEach((key) => {
+      if (params[key] != null && params[key] !== "") url.searchParams.set(key, String(params[key]));
+    });
+    url.searchParams.set("key", apiKey());
+    const res = await fetchImpl(url, { method: "GET" });
+    const body = await res.json().catch(() => ({}));
+    if (!res.ok) {
+      const reason = body && body.error && body.error.errors && body.error.errors[0] && body.error.errors[0].reason;
+      if (res.status === 403 && (reason === "quotaExceeded" || reason === "dailyLimitExceeded")) {
+        markExhausted();
+        fail(429, QUOTA_MESSAGE);
+      }
+      fail(502, "유튜브에서 정보를 가져오지 못했습니다.");
+    }
+    return body;
+  }
+
+  function thumbUrl(id, thumbs) {
+  const pic = thumbs || {};
+  const fromApi = (pic.medium && pic.medium.url) || (pic.high && pic.high.url) || (pic.default && pic.default.url) || "";
+  if (fromApi) return fromApi;
+  if (id) return "https://i.ytimg.com/vi/" + id + "/mqdefault.jpg";
+  return "";
+}
+
+function videoKind(durationSec) {
+    if (durationSec == null) return "unknown";
+    return durationSec <= 60 ? "shorts" : "long";
+  }
+
+  function publicVideo(item) {
+    return {
+      videoId: item.videoId,
+      title: item.title,
+      channelId: item.channelId,
+      channelTitle: item.channelTitle,
+      publishedAt: item.publishedAt,
+      viewCount: item.viewCount,
+      subscriberCount: item.subscriberHidden ? null : item.subscriberCount,
+      subscriberHidden: !!item.subscriberHidden,
+      score: item.score,
+      durationSec: item.durationSec,
+      kind: videoKind(item.durationSec),
+      url: "https://www.youtube.com/watch?v=" + item.videoId,
+      thumbnail: item.thumbnail || "",
+    };
+  }
+
+  async function loadSearch(query, period) {
+    const key = "search:" + query + ":" + String(period || "30");
+    const hit = cacheGet(key, SEARCH_TTL_MS);
+    if (hit) return { videos: hit, cached: true };
+    const publishedAfter = { "7": 7, "30": 30, "90": 90, "365": 365 }[String(period || "30")];
+    const params = {
+      part: "snippet",
+      type: "video",
+      maxResults: SAMPLE_SIZE,
+      q: query,
+      order: "viewCount",
+      regionCode: "KR",
+    };
+    if (publishedAfter) {
+      params.publishedAfter = new Date(nowFn().getTime() - publishedAfter * 86400000).toISOString();
+    }
+    spend(SEARCH_COST);
+    const searched = await yt("search", params);
+    const ids = (searched.items || [])
+      .map((item) => item.id && item.id.videoId)
+      .filter(Boolean);
+    if (!ids.length) {
+      cacheSet(key, []);
+      return { videos: [], cached: false };
+    }
+    spend(LIST_COST);
+    const details = await yt("videos", {
+      part: "snippet,statistics,contentDetails",
+      id: ids.join(","),
+      maxResults: SAMPLE_SIZE,
+    });
+    const channelIds = [...new Set((details.items || []).map((item) => item.snippet && item.snippet.channelId).filter(Boolean))];
+    let channels = { items: [] };
+    if (channelIds.length) {
+      spend(LIST_COST);
+      channels = await yt("channels", {
+        part: "statistics",
+        id: channelIds.join(","),
+        maxResults: SAMPLE_SIZE,
+      });
+    }
+    const subs = {};
+    (channels.items || []).forEach((item) => {
+      subs[item.id] = {
+        count: Number(item.statistics && item.statistics.subscriberCount),
+        hidden: !!(item.statistics && item.statistics.hiddenSubscriberCount),
+      };
+    });
+    const videos = (details.items || []).map((item) => {
+      const channel = subs[item.snippet.channelId] || { count: null, hidden: true };
+      const views = Number(item.statistics && item.statistics.viewCount);
+      return {
+        videoId: item.id,
+        title: item.snippet.title,
+        channelId: item.snippet.channelId,
+        channelTitle: item.snippet.channelTitle,
+        publishedAt: item.snippet.publishedAt,
+        viewCount: Number.isFinite(views) ? views : null,
+        subscriberCount: channel.hidden ? null : channel.count,
+        subscriberHidden: channel.hidden,
+        score: performanceScore(views, channel.count, channel.hidden),
+        durationSec: isoDurationSeconds(item.contentDetails && item.contentDetails.duration),
+        thumbnail: thumbUrl(item.id, item.snippet && item.snippet.thumbnails),
+      };
+    });
+    cacheSet(key, videos);
+    return { videos, cached: false };
+  }
+
+  async function search(input) {
+    const query = String((input && input.q) || "").trim().replace(/\s+/g, " ");
+    if (!query) fail(400, "찾을 단어를 입력해 주세요.");
+    if (query.length > 80) fail(400, "찾을 단어는 80자 안으로 입력해 주세요.");
+    const period = ["7", "30", "90", "365", "all"].includes(String(input.period)) ? String(input.period) : "30";
+    const kind = ["all", "shorts", "long"].includes(String(input.kind)) ? String(input.kind) : "all";
+    const key = "search:" + query.toLowerCase() + ":" + period;
+    const cached = !!cacheGet(key, SEARCH_TTL_MS);
+    if (!cached) takeUser(input.email, "search", USER_SEARCH_LIMIT);
+    const loaded = await loadSearch(query.toLowerCase(), period);
+    const videos = loaded.videos
+      .map(publicVideo)
+      .filter((item) => kind === "all" || item.kind === kind);
+    return {
+      cached: loaded.cached,
+      query,
+      period,
+      kind,
+      videos,
+      quota: { used: dayBook().used, limit: DAILY_QUOTA },
+    };
+  }
+
+  async function loadChannel(parsed) {
+    const lookupKey = parsed.id ? "id:" + parsed.id : "handle:" + parsed.handle.toLowerCase();
+    const cached = cacheGet("channel:" + lookupKey, STATS_TTL_MS);
+    if (cached) return { channel: cached, cached: true };
+    spend(LIST_COST);
+    const found = await yt("channels", Object.assign({
+      part: "snippet,statistics,contentDetails",
+      maxResults: 1,
+    }, parsed.id ? { id: parsed.id } : { forHandle: parsed.handle }));
+    const channel = (found.items || [])[0];
+    if (!channel) fail(404, "채널을 찾지 못했습니다.");
+    const uploads = channel.contentDetails && channel.contentDetails.relatedPlaylists && channel.contentDetails.relatedPlaylists.uploads;
+    let recent = [];
+    if (uploads) {
+      spend(LIST_COST);
+      const playlist = await yt("playlistItems", {
+        part: "contentDetails",
+        playlistId: uploads,
+        maxResults: SAMPLE_SIZE,
+      });
+      const ids = (playlist.items || []).map((item) => item.contentDetails && item.contentDetails.videoId).filter(Boolean);
+      if (ids.length) {
+        spend(LIST_COST);
+        const details = await yt("videos", {
+          part: "snippet,statistics,contentDetails",
+          id: ids.join(","),
+          maxResults: SAMPLE_SIZE,
+        });
+        const hidden = !!(channel.statistics && channel.statistics.hiddenSubscriberCount);
+        const subs = Number(channel.statistics && channel.statistics.subscriberCount);
+        recent = (details.items || []).map((item) => {
+          const views = Number(item.statistics && item.statistics.viewCount);
+          return {
+            videoId: item.id,
+            title: item.snippet.title,
+            publishedAt: item.snippet.publishedAt,
+            viewCount: Number.isFinite(views) ? views : null,
+            durationSec: isoDurationSeconds(item.contentDetails && item.contentDetails.duration),
+            score: performanceScore(views, subs, hidden),
+            thumbnail: thumbUrl(item.id, item.snippet && item.snippet.thumbnails),
+            url: "https://www.youtube.com/watch?v=" + item.id,
+          };
+        });
+      }
+    }
+    const hidden = !!(channel.statistics && channel.statistics.hiddenSubscriberCount);
+    const outlier = outliersFrom(recent);
+    const cadence = uploadLabel(recent);
+    const value = {
+      id: channel.id,
+      title: channel.snippet.title,
+      handle: (channel.snippet.customUrl || "").replace(/^@/, ""),
+      thumbnail: (channel.snippet.thumbnails && channel.snippet.thumbnails.medium && channel.snippet.thumbnails.medium.url) || "",
+      url: "https://www.youtube.com/channel/" + channel.id,
+      subscribers: hidden ? null : Number(channel.statistics && channel.statistics.subscriberCount),
+      subscriberHidden: hidden,
+      views: Number(channel.statistics && channel.statistics.viewCount),
+      videoCount: Number(channel.statistics && channel.statistics.videoCount),
+      recentCount: recent.length,
+      recentAverageViews: outlier.averageViews,
+      uploadEveryDays: cadence.uploadEveryDays,
+      uploadLabel: cadence.uploadLabel,
+      outliers: outlier.outliers,
+      recentVideos: recent.slice(0, 10),
+    };
+    cacheSet("channel:" + lookupKey, value);
+    cacheSet("channel:id:" + channel.id, value);
+    return { channel: value, cached: false };
+  }
+
+  async function compare(input) {
+    const lines = String((input && input.q) || "")
+      .split(/\r?\n/)
+      .map((item) => item.trim())
+      .filter(Boolean);
+    if (!lines.length) fail(400, "비교할 채널 주소를 입력해 주세요.");
+    const chosen = lines.slice(0, 3);
+    const channels = [];
+    for (const line of chosen) {
+      try {
+        const parsed = parseChannelInput(line);
+        const lookupKey = parsed.id ? "id:" + parsed.id : "handle:" + parsed.handle.toLowerCase();
+        const cached = cacheGet("channel:" + lookupKey, STATS_TTL_MS) || (parsed.id && cacheGet("channel:id:" + parsed.id, STATS_TTL_MS));
+        if (!cached) takeUser(input.email, "channel", USER_CHANNEL_LIMIT);
+        const loaded = await loadChannel(parsed);
+        channels.push(loaded.channel);
+      } catch (err) {
+        channels.push({ query: line, error: err.message || "채널을 찾지 못했습니다." });
+      }
+    }
+    return { channels, trimmed: lines.length > 3, quota: { used: dayBook().used, limit: DAILY_QUOTA } };
+  }
+
+  function status(email) {
+    const day = kstDay(nowFn());
+    const id = String(email || "").trim().toLowerCase();
+    const used = (store.load().usage[id] && store.load().usage[id][day]) || { search: 0, channel: 0 };
+    const book = dayBook();
+    return {
+      enabled: true,
+      quotaUsed: book.used,
+      quotaLimit: DAILY_QUOTA,
+      searchUsed: used.search,
+      searchLimit: USER_SEARCH_LIMIT,
+      channelUsed: used.channel,
+      channelLimit: USER_CHANNEL_LIMIT,
+    };
+  }
+
+  return {
+    search,
+    compare,
+    status,
+    parseChannelInput,
+    performanceScore,
+    outliersFrom,
+    isoDurationSeconds,
+  };
+}
+
+function mountYtResearch(app, deps) {
+  const source = deps || {};
+  if (!researchEnabled(source.env || process.env)) {
+    const off = (_req, res) => res.status(404).json({ error: "유튜브 리서치는 꺼져 있습니다." });
+    app.use("/api/yt-research", off);
+    return { enabled: false };
+  }
+  const research = source.research || createYtResearch(source);
+  function user(req) {
+    const session = source.getSession(req);
+    if (!session || !session.email) return null;
+    return session;
+  }
+  app.get("/api/yt-research/status", (req, res) => {
+    const session = user(req);
+    if (!session) return res.status(401).json({ error: "로그인이 필요합니다." });
+    res.json(research.status(session.email));
+  });
+  app.get("/api/yt-research/search", async (req, res) => {
+    const session = user(req);
+    if (!session) return res.status(401).json({ error: "로그인이 필요합니다." });
+    try {
+      res.json(await research.search({
+        email: session.email,
+        q: req.query.q,
+        period: req.query.period,
+        kind: req.query.kind,
+      }));
+    } catch (err) {
+      res.status(err.status || 500).json({ error: err.message });
+    }
+  });
+  app.get("/api/yt-research/channels", async (req, res) => {
+    const session = user(req);
+    if (!session) return res.status(401).json({ error: "로그인이 필요합니다." });
+    try {
+      res.json(await research.compare({ email: session.email, q: req.query.q }));
+    } catch (err) {
+      res.status(err.status || 500).json({ error: err.message });
+    }
+  });
+  return { enabled: true, research };
+}
+
+module.exports = {
+  DAILY_QUOTA,
+  QUOTA_STOP,
+  SEARCH_COST,
+  OUTLIER_RATIO,
+  USER_SEARCH_LIMIT,
+  USER_CHANNEL_LIMIT,
+  researchEnabled,
+  parseChannelInput,
+  performanceScore,
+  outliersFrom,
+  isoDurationSeconds,
+  uploadLabel,
+  createYtResearch,
+  mountYtResearch,
+};
