+        channels.push(loaded.channel);
+      } catch (err) {
+        channels.push({ query: line, error: err.message || "채널을 찾지 못했습니다." });
+      }
+    }
+    return { channels, trimmed: lines.length > 3, quota: { used: dayBook().used, limit: DAILY_QUOTA } };
+  }
+
+  function status(email) {
+    const day = kstDay(nowFn());
+    const id = String(email || "").trim().toLowerCase();
+    const used = (store.load().usage[id] && store.load().usage[id][day]) || { search: 0, channel: 0 };
+    const book = dayBook();
+    return {
+      enabled: true,
+      quotaUsed: book.used,
+      quotaLimit: DAILY_QUOTA,
+      searchUsed: used.search,
+      searchLimit: USER_SEARCH_LIMIT,
+      channelUsed: used.channel,
+      channelLimit: USER_CHANNEL_LIMIT,
+    };
+  }
