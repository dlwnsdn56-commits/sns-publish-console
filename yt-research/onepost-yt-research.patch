+    const session = user(req);
+    if (!session) return res.status(401).json({ error: "로그인이 필요합니다." });
+    try {
+      res.json(await research.compare({ email: session.email, q: req.query.q }));
+    } catch (err) {
+      res.status(err.status || 500).json({ error: err.message });
+    }
+  });
+  return { enabled: true, research };
+}
+
+module.exports = {
+  DAILY_QUOTA,
+  QUOTA_STOP,
+  SEARCH_COST,
+  OUTLIER_RATIO,
+  USER_SEARCH_LIMIT,
+  USER_CHANNEL_LIMIT,
+  researchEnabled,
+  parseChannelInput,
+  performanceScore,
+  outliersFrom,
+  isoDurationSeconds,
+  uploadLabel,
+  createYtResearch,
+  mountYtResearch,
+};
