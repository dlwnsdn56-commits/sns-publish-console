+(function (root, factory) {
+  const api = factory();
+  if (typeof module === "object" && module.exports) module.exports = api;
+  else root.YtReport = api;
+})(typeof globalThis !== "undefined" ? globalThis : this, function () {
+  const PLAN = [
+    { label: "제품", count: 4 },
+    { label: "밈", count: 3 },
+    { label: "썰", count: 3 },
+  ];
+  const DISTRIBUTE = ["유튜브", "인스타그램", "페이스북", "스레드", "틱톡", "X", "네이버 클립"];
+
+  function finite(value) {
+    return typeof value === "number" && Number.isFinite(value);
+  }
+
+  function seoulParts(date) {
+    const fmt = new Intl.DateTimeFormat("en-CA", {
+      timeZone: "Asia/Seoul",
+      year: "numeric",
+      month: "2-digit",
+      day: "2-digit",
+    });
+    const parts = {};
+    fmt.formatToParts(date).forEach((part) => {
+      parts[part.type] = part.value;
+    });
+    return parts;
+  }
+
+  function koreanDate(date) {
+    const parts = seoulParts(date);
+    return Number(parts.year) + "년 " + Number(parts.month) + "월 " + Number(parts.day) + "일";
+  }
+
+  function docNo(channel, date) {
+    const parts = seoulParts(date);
+    const raw = String((channel && (channel.handle || channel.id)) || "CHNL").replace(/[^a-z0-9]/gi, "").toUpperCase();
+    const code = (raw.slice(0, 4) || "CHNL").padEnd(4, "X");
+    return "AET-" + code + "-" + parts.year + parts.month + parts.day;
+  }
+
+  function readInstagram(input) {
+    const src = input && input.instagram;
+    if (!src || typeof src !== "object") return { connected: false };
+    const posts = finite(src.posts) ? src.posts : null;
+    const followers = finite(src.followers) ? src.followers : null;
+    const following = finite(src.following) ? src.following : null;
+    const reactions = finite(src.reactions) ? src.reactions : null;
+    const handle = String(src.handle || "").trim().replace(/^@/, "");
+    const connected = posts != null || followers != null || following != null || reactions != null;
+    return { connected, handle, posts, followers, following, reactions };
+  }
+
+  function recentList(channel) {
+    return Array.isArray(channel && channel.recentVideos) ? channel.recentVideos.slice(0, 10) : [];
+  }
+
+  function shortsRatio(videos) {
+    const known = videos.filter((item) => finite(item.durationSec));
+    if (!known.length) return null;
+    const shorts = known.filter((item) => item.durationSec <= 60).length;
+    return Math.round((shorts / known.length) * 100);
+  }
+
+  function perWeek(videos, now) {
+    const cutoff = now.getTime() - 90 * 86400000;
+    const count = videos.filter((item) => {
+      const time = Date.parse(item.publishedAt || "");
+      return Number.isFinite(time) && time >= cutoff;
+    }).length;
+    if (!videos.length) return null;
+    return Math.round((count / (90 / 7)) * 10) / 10;
+  }
+
+  function viewTrend(videos) {
+    const dated = videos
+      .filter((item) => finite(item.viewCount) && Number.isFinite(Date.parse(item.publishedAt || "")))
+      .slice()
+      .sort((a, b) => Date.parse(a.publishedAt) - Date.parse(b.publishedAt));
+    if (dated.length < 4) return null;
+    const mid = Math.floor(dated.length / 2);
+    const avg = (list) => list.reduce((sum, item) => sum + item.viewCount, 0) / list.length;
+    const older = avg(dated.slice(0, mid));
+    const newer = avg(dated.slice(mid));
+    if (older <= 0) return null;
+    const ratio = newer / older;
+    if (ratio >= 1.2) return "up";
+    if (ratio <= 0.8) return "down";
+    return "flat";
+  }
+
+  function avgPerVideo(channel) {
+    if (finite(channel.views) && finite(channel.videoCount) && channel.videoCount > 0) {
+      return Math.round(channel.views / channel.videoCount);
+    }
+    return finite(channel.recentAverageViews) ? channel.recentAverageViews : null;
+  }
+
+  function buildReport(input) {
+    const source = input || {};
+    const now = source.now instanceof Date ? source.now : new Date();
+    const channel = source.youtube || null;
+    const instagram = readInstagram(source);
+    const videos = recentList(channel);
+    const brand = String(source.brandName || (channel && channel.title) || "채널").trim() || "채널";
+    const handle = channel && channel.handle ? String(channel.handle).replace(/^@/, "") : "";
+    const dateText = koreanDate(now);
+    const ratio = shortsRatio(videos);
+    const weekly = perWeek(videos, now);
+    const trend = viewTrend(videos);
+    const outlier = channel && Array.isArray(channel.outliers) && channel.outliers[0];
+    const average = avgPerVideo(channel || {});
+    const bars = videos.slice(0, 10).map((item) => ({
+      title: item.title || "",
+      views: finite(item.viewCount) ? item.viewCount : null,
+      thumbnail: item.thumbnail || (item.videoId ? "https://i.ytimg.com/vi/" + item.videoId + "/mqdefault.jpg" : ""),
+    }));
+
+    const observations = [];
+    if (weekly != null) observations.push("최근 90일 공개 영상 기준으로 주 " + weekly + "편입니다.");
+    if (ratio != null) observations.push("최근 영상 중 1분 이하 쇼츠 비중은 " + ratio + "%입니다.");
+    if (finite(source.subscriberDelta)) {
+      const sign = source.subscriberDelta > 0 ? "+" : "";
+      observations.push("최근 30일 구독자 증감 " + sign + source.subscriberDelta + "명입니다.");
+    } else {
+      observations.push("최근 30일 구독자 증감은 이전 기록이 없어 적지 않았습니다.");
+    }
+
+    let summary = brand + " 채널의 공개 숫자를 한 장으로 모았습니다.";
+    let summaryBold = "공개된 숫자만";
+    if (ratio != null && ratio >= 70) {
+      summaryBold = "쇼츠 비중 " + ratio + "%";
+      summary = "최근 영상은 짧은 영상이 대부분입니다. 긴 영상의 비중은 작습니다.";
+    } else if (trend === "up") {
+      summaryBold = "최근 조회가 앞선 영상보다 높습니다";
+      summary = "같은 채널의 최근 쪽 영상이 그보다 앞선 영상보다 더 많이 재생됐습니다.";
+    } else if (outlier) {
+      summaryBold = "평균을 크게 넘은 영상이 있습니다";
+      summary = "최근 영상 가운데 다른 영상보다 훨씬 많이 본 영상이 있습니다.";
+    }
+
+    const strengths = [
+      ratio == null
+        ? { title: "영상 길이", body: "길이 정보가 없어 쇼츠 비중은 계산하지 않았습니다." }
+        : { title: "쇼츠 비중", body: "최근 확인한 영상 중 1분 이하는 " + ratio + "%입니다." },
+      weekly == null
+        ? { title: "올리는 간격", body: "날짜가 있는 최근 영상이 없어 간격을 계산하지 않았습니다." }
+        : { title: "올리는 간격", body: "최근 90일 기준으로 주 " + weekly + "편입니다." },
+      outlier
+        ? { title: "유난히 본 영상", body: "‘" + outlier.title + "’이 다른 최근 영상 평균의 " + outlier.multiple + "배입니다." }
+        : { title: "유난히 본 영상", body: "최근 영상 중 다른 영상 평균의 3배를 넘는 영상은 없습니다." },
+      channel && channel.subscriberHidden
+        ? { title: "구독자 공개", body: "구독자 수는 채널이 비공개로 두었습니다." }
+        : { title: "구독자 공개", body: finite(channel && channel.subscribers) ? "구독자 수 " + channel.subscribers.toLocaleString("ko-KR") + "명이 공개되어 있습니다." : "구독자 수를 가져오지 못했습니다." },
+      trend === "up"
+        ? { title: "조회 흐름", body: "최근 쪽이 그보다 앞선 영상보다 더 많이 재생됐습니다." }
+        : trend === "down"
+          ? { title: "조회 흐름", body: "최근 쪽이 그보다 앞선 영상보다 덜 재생됐습니다." }
+          : trend === "flat"
+            ? { title: "조회 흐름", body: "최근 조회가 크게 오르거나 내리지 않았습니다." }
+            : { title: "조회 흐름", body: "비교할 최근 영상이 4편 미만이라 흐름은 적지 않았습니다." },
+    ];
+
+    const diagnosis = [
+      "이 문단은 확정 평가가 아니라, 위에서 확인한 공개 숫자로만 적은 추정입니다. " +
+        (ratio == null ? "쇼츠 비중은 길이 정보가 없어 빼 두었습니다." : "쇼츠 비중 " + ratio + "%를 기준으로 짧은 영상이 채널의 현재 얼굴인지 가늠합니다."),
+      (weekly == null ? "올리는 간격은 계산하지 못했습니다." : "주 " + weekly + "편 페이스와 ") +
+        (outlier ? "평균을 넘은 영상의 형식을 다음 기획의 출발점으로 볼 수 있습니다." : "아직 평균을 크게 넘는 영상이 없어, 한 형식을 정답으로 두지 않는 편이 안전합니다.") +
+        " 조회수나 매출은 보장하지 않습니다.",
+    ];
+
+    const next = [
+      { title: "길이 구성", body: ratio != null && ratio >= 70 ? "쇼츠를 기본으로 두되, 설명이 필요한 주제만 긴 영상으로 섞습니다." : "짧은 영상과 긴 영상을 주제마다 나눠 올립니다." },
+      { title: "올리는 리듬", body: weekly != null && weekly < 1 ? "최근 90일이 주 1편보다 적습니다. 같은 요일에 한 편씩 고정하는 쪽을 먼저 봅니다." : "지금 간격을 깨지 않는 범위에서 같은 요일에 맞춥니다." },
+      { title: "잘 된 형식", body: outlier ? "많이 본 ‘" + outlier.title + "’과 같은 구성으로 다음 한 편을 잡아 봅니다." : "아직 튀는 한 편이 없어, 제품 소개 한 가지를 같은 구성으로 세 편 찍어 비교합니다." },
+      { title: "같이 올리기", body: "원포스트에 연결된 채널이 있으면 같은 영상을 그 채널에도 올립니다. 연결되지 않은 채널 숫자는 적지 않습니다." },
+    ];
+
+    const platforms = [];
+    if (channel) platforms.push("유튜브");
+    if (instagram.connected || instagram.handle) platforms.push("인스타그램");
+
+    return {
+      docNo: docNo(channel, now),
+      brand,
+      handle,
+      dateText,
+      author: "에테르 대표 이준우",
+      subline: (platforms.join("·") || "유튜브") + (handle ? " @" + handle : "") + " | 조사일 " + dateText + " 공개 채널 기준",
+      summary,
+      summaryBold,
+      youtube: channel ? {
+        connected: true,
+        subscribers: channel.subscriberHidden ? null : (finite(channel.subscribers) ? channel.subscribers : null),
+        subscriberHidden: !!channel.subscriberHidden,
+        videos: finite(channel.videoCount) ? channel.videoCount : null,
+        views: finite(channel.views) ? channel.views : null,
+        average,
+      } : { connected: false },
+      instagram,
+      observations,
+      bars,
+      strengths,
+      diagnosis,
+      next,
+      plan: PLAN,
+      distribute: DISTRIBUTE,
+      footerNote: "본 자료는 " + dateText + " 공개 채널 기준의 현황 분석입니다. 조회수나 성과를 보장하지 않습니다.",
+    };
+  }
+
+  return { buildReport, readInstagram, DISTRIBUTE, PLAN };
+});
diff -u -r -N a/test/yt-report.test.js b/test/yt-report.test.js
--- a/test/yt-report.test.js	1970-01-01 00:00:00.000000000 +0000
+++ b/test/yt-report.test.js	2026-11-12 07:31:45.247470477 +0000
@@ -0,0 +1,58 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const { buildReport } = require("../public/yt-report");
+
+const youtube = {
+  title: "테스트키친",
+  handle: "testkitchen",
+  id: "UCabcdefghijklmnopqrstuv",
+  subscribers: 1500,
+  subscriberHidden: false,
+  videoCount: 34,
+  views: 120000,
+  outliers: [{ title: "혼밥 김치찌개", multiple: 12 }],
+  recentVideos: [
+    { videoId: "abc", title: "옛 영상", publishedAt: "2026-08-01T00:00:00.000Z", viewCount: 1000, durationSec: 40 },
+    { title: "옛 영상 2", publishedAt: "2026-08-20T00:00:00.000Z", viewCount: 1100, durationSec: 50 },
+    { title: "최근 1", publishedAt: "2026-10-20T00:00:00.000Z", viewCount: 4000, durationSec: 30 },
+    { title: "최근 2", publishedAt: "2026-11-02T00:00:00.000Z", viewCount: 4800, durationSec: 500 },
+  ],
+};
+
+test("report uses real youtube numbers and does not invent instagram", () => {
+  const report = buildReport({ youtube, now: new Date("2026-11-12T03:00:00.000Z") });
+  assert.equal(report.instagram.connected, false);
+  assert.equal(report.youtube.subscribers, 1500);
+  assert.equal(report.youtube.videos, 34);
+  assert.equal(report.youtube.views, 120000);
+  assert.equal(report.youtube.average, Math.round(120000 / 34));
+  assert.equal(report.strengths.length, 5);
+  assert.equal(report.next.length, 4);
+  assert.equal(report.diagnosis.length, 2);
+  assert.equal(report.diagnosis[0].includes("확정"), true);
+  assert.equal(JSON.stringify(report.instagram).includes("999"), false);
+  assert.equal(report.distribute.includes("구글 블로그"), false);
+  assert.equal(report.distribute.length, 7);
+  assert.equal(report.bars[0].views, 1000);
+  assert.equal(report.bars[0].thumbnail, "https://i.ytimg.com/vi/abc/mqdefault.jpg");
+});
+
+test("instagram numbers appear only when supplied", () => {
+  const empty = buildReport({ youtube, instagram: { handle: "shop" }, now: new Date("2026-11-12T00:00:00.000Z") });
+  assert.equal(empty.instagram.connected, false);
+  const filled = buildReport({
+    youtube,
+    instagram: { posts: 12, followers: 340, following: 20, reactions: 80, handle: "shop" },
+    now: new Date("2026-11-12T00:00:00.000Z"),
+  });
+  assert.equal(filled.instagram.connected, true);
+  assert.equal(filled.instagram.followers, 340);
+  assert.equal(filled.instagram.posts, 12);
+});
+
+test("subscriber change is omitted unless a real delta is passed", () => {
+  const report = buildReport({ youtube, now: new Date("2026-11-12T00:00:00.000Z") });
+  assert.equal(report.observations.some((line) => line.includes("이전 기록")), true);
+  const withDelta = buildReport({ youtube, subscriberDelta: -3, now: new Date("2026-11-12T00:00:00.000Z") });
+  assert.equal(withDelta.observations.some((line) => line.includes("-3")), true);
+});
diff -u -r -N a/test/yt-research.test.js b/test/yt-research.test.js
--- a/test/yt-research.test.js	1970-01-01 00:00:00.000000000 +0000
+++ b/test/yt-research.test.js	2026-11-12 07:31:45.247470477 +0000
@@ -0,0 +1,198 @@
+const fs = require("fs");
+const os = require("os");
+const path = require("path");
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const express = require("express");
+const {
+  createYtResearch,
+  mountYtResearch,
+  parseChannelInput,
+  performanceScore,
+  outliersFrom,
+  OUTLIER_RATIO,
+  QUOTA_STOP,
+  SEARCH_COST,
+} = require("../lib/yt-research");
+
+function jsonResponse(status, body) {
+  return {
+    ok: status >= 200 && status < 300,
+    status,
+    json: async () => body,
+  };
+}
+
+function youtubeMock(calls) {
+  return async (url) => {
+    const pathName = url.pathname;
+    calls.push(pathName + "?" + url.searchParams.toString().replace(/key=[^&]+/, "key=REDACTED"));
+    assert.equal(url.searchParams.get("key"), "test-key");
+    if (pathName.endsWith("/search")) {
+      return jsonResponse(200, {
+        items: [
+          { id: { videoId: "short1" } },
+          { id: { videoId: "long1" } },
+        ],
+      });
+    }
+    if (pathName.endsWith("/videos")) {
+      const ids = url.searchParams.get("id").split(",");
+      return jsonResponse(200, {
+        items: ids.map((id) => ({
+          id,
+          snippet: {
+            title: id === "short1" ? "쇼츠 레시피" : id === "hit1" ? "대박 영상" : "일반 영상",
+            channelId: "UCabcdefghijklmnopqrstuv",
+            channelTitle: "테스트키친",
+            publishedAt: id === "hit1" ? "2026-11-01T00:00:00.000Z" : "2026-11-08T00:00:00.000Z",
+            thumbnails: { medium: { url: "" } },
+          },
+          statistics: { viewCount: id === "hit1" ? "30000" : id === "short1" ? "12000" : "1000" },
+          contentDetails: { duration: id === "short1" ? "PT45S" : "PT5M" },
+        })),
+      });
+    }
+    if (pathName.endsWith("/channels")) {
+      if (url.searchParams.get("forHandle") === "missing") return jsonResponse(200, { items: [] });
+      return jsonResponse(200, {
+        items: [{
+          id: "UCabcdefghijklmnopqrstuv",
+          snippet: { title: "테스트키친", customUrl: "@testkitchen", thumbnails: { medium: { url: "" } } },
+          statistics: { subscriberCount: "1000", viewCount: "50000", videoCount: "20", hiddenSubscriberCount: false },
+          contentDetails: { relatedPlaylists: { uploads: "UUabcdefghijklmnopqrstuv" } },
+        }],
+      });
+    }
+    if (pathName.endsWith("/playlistItems")) {
+      return jsonResponse(200, {
+        items: [
+          { contentDetails: { videoId: "hit1" } },
+          { contentDetails: { videoId: "long1" } },
+          { contentDetails: { videoId: "long1" } },
+        ],
+      });
+    }
+    return jsonResponse(500, {});
+  };
+}
+
+function harness() {
+  const calls = [];
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "yt-research-"));
+  const research = createYtResearch({
+    file: path.join(dir, "cache.json"),
+    now: () => new Date("2026-11-12T03:00:00.000Z"),
+    fetch: youtubeMock(calls),
+    env: { YOUTUBE_API_KEY: "test-key", YT_RESEARCH_ENABLED: "1" },
+  });
+  return { research, calls, dir };
+}
+
+test("score is views divided by subscribers and outliers are at least three times the average", () => {
+  assert.equal(performanceScore(12000, 1000, false), 12);
+  assert.equal(performanceScore(12000, 0, true), null);
+  const found = outliersFrom([
+    { videoId: "a", viewCount: 1000 },
+    { videoId: "b", viewCount: 1000 },
+    { videoId: "c", viewCount: 9000 },
+  ]);
+  assert.equal(OUTLIER_RATIO, 3);
+  assert.equal(found.averageViews, 3667);
+  assert.deepEqual(found.outliers.map((item) => item.videoId), ["c"]);
+});
+
+test("keyword search is cached, filterable, and does not call YouTube again", async () => {
+  const { research, calls } = harness();
+  const first = await research.search({ email: "Owner@example.test", q: "김치찌개", period: "30", kind: "shorts" });
+  assert.equal(first.cached, false);
+  assert.equal(first.videos.length, 1);
+  assert.equal(first.videos[0].kind, "shorts");
+  assert.equal(first.videos[0].score, 12);
+  assert.equal(first.videos[0].subscriberCount, 1000);
+  const again = await research.search({ email: "owner@example.test", q: "김치찌개", period: "30", kind: "long" });
+  assert.equal(again.cached, true);
+  assert.equal(again.videos.length, 1);
+  assert.equal(again.videos[0].kind, "long");
+  assert.equal(calls.length, 3);
+});
+
+test("channel compare keeps three channels and marks videos far above the recent average", async () => {
+  const { research, calls } = harness();
+  const parsed = parseChannelInput("https://www.youtube.com/@TestKitchen");
+  assert.deepEqual(parsed, { handle: "testkitchen" });
+  const result = await research.compare({
+    email: "owner@example.test",
+    q: "@TestKitchen\nhttps://www.youtube.com/channel/UCabcdefghijklmnopqrstuv\n@missing\n@fourth",
+  });
+  assert.equal(result.trimmed, true);
+  assert.equal(result.channels.length, 3);
+  assert.equal(result.channels[0].title, "테스트키친");
+  assert.equal(result.channels[0].subscribers, 1000);
+  assert.equal(result.channels[0].videoCount, 20);
+  assert.equal(result.channels[0].outliers[0].videoId, "hit1");
+  assert.equal(result.channels[0].recentVideos[0].thumbnail, "https://i.ytimg.com/vi/hit1/mqdefault.jpg");
+  assert.equal(result.channels[1].id, "UCabcdefghijklmnopqrstuv");
+  assert.equal(result.channels[2].error, "채널을 찾지 못했습니다.");
+  const second = await research.compare({ email: "owner@example.test", q: "@TestKitchen" });
+  assert.equal(second.channels[0].title, "테스트키친");
+  assert.equal(calls.filter((item) => item.startsWith("/youtube/v3/channels")).length >= 1, true);
+});
+
+test("quota and per-user limits stop before another YouTube call", async () => {
+  const calls = [];
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "yt-research-"));
+  const file = path.join(dir, "cache.json");
+  fs.writeFileSync(file, JSON.stringify({
+    cache: {},
+    usage: {},
+    quota: { "2026-11-12": { used: QUOTA_STOP - SEARCH_COST + 1, exhausted: false } },
+  }));
+  const research = createYtResearch({
+    file,
+    now: () => new Date("2026-11-12T03:00:00.000Z"),
+    fetch: youtubeMock(calls),
+    env: { YOUTUBE_API_KEY: "test-key" },
+  });
+  await assert.rejects(
+    () => research.search({ email: "owner@example.test", q: "새 검색", period: "7" }),
+    /오늘 유튜브에서 받아올 수 있는 횟수/
+  );
+  assert.equal(calls.length, 0);
+
+  const limited = harness();
+  for (let i = 0; i < 8; i += 1) {
+    await limited.research.search({ email: "owner@example.test", q: "단어" + i, period: "all" });
+  }
+  await assert.rejects(
+    () => limited.research.search({ email: "owner@example.test", q: "단어여분", period: "all" }),
+    /이 계정으로 찾을 수 있는 횟수/
+  );
+});
+
+test("the flag hides the routes and the source does not contain an API key", async () => {
+  const source = fs.readFileSync(path.join(__dirname, "..", "lib", "yt-research.js"), "utf8");
+  assert.equal(source.includes("AIza"), false);
+  assert.equal(source.includes("YOUTUBE_API_KEY"), true);
+  assert.equal(source.includes('YT_RESEARCH_ENABLED || "") === "1"'), true);
+  const app = express();
+  const mounted = mountYtResearch(app, { env: {} });
+  assert.equal(mounted.enabled, false);
+  const server = await new Promise((resolve) => {
+    const listening = app.listen(0, "127.0.0.1", () => resolve(listening));
+  });
+  const port = server.address().port;
+  const res = await fetch("http://127.0.0.1:" + port + "/api/yt-research/search?q=test");
+  const body = await res.json();
+  assert.equal(res.status, 404);
+  assert.equal(body.error, "유튜브 리서치는 꺼져 있습니다.");
+  await new Promise((resolve) => server.close(resolve));
+
+  const indexPath = path.join(__dirname, "..", "public", "index.html");
+  if (fs.existsSync(indexPath)) {
+    const index = fs.readFileSync(indexPath, "utf8");
+    assert.equal(index.includes("유튜브 리서치"), true);
+    assert.equal(index.includes("월 9,900원"), true);
+    assert.equal(index.includes("terms.html") || index.includes("/terms"), true);
+  }
+});
