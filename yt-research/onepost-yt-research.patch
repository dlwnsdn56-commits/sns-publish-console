+  return {
+    search,
+    compare,
+    status,
+    parseChannelInput,
+    performanceScore,
+    outliersFrom,
+    isoDurationSeconds,
+  };
+}
+
+function mountYtResearch(app, deps) {
+  const source = deps || {};
+  if (!researchEnabled(source.env || process.env)) {
+    const off = (_req, res) => res.status(404).json({ error: "유튜브 리서치는 꺼져 있습니다." });
