--- a/test/agency-rules.test.js
+++ b/test/agency-rules.test.js
@@ -0,0 +1,21 @@
+const fs = require("fs");
+const path = require("path");
+const test = require("node:test");
+const assert = require("node:assert/strict");
+
+const root = path.join(__dirname, "..", "public");
+const files = ["index.html", "ether.html", "agency.html"].map((name) =>
+  fs.readFileSync(path.join(root, name), "utf8")
+);
+
+test("agency pages state rollover, three-month minimum, and unpaid auto-charge", () => {
+  for (const text of files) {
+    assert.equal(text.includes("다음 달까지만 이월"), true);
+    assert.equal(text.includes("최소 3개월"), true);
+    assert.equal(text.includes("자동결제(준비 중)"), true);
+    assert.equal(text.includes("전액 환불"), false);
+    assert.equal(text.includes("위약금"), false);
+    assert.equal(text.includes("10편 충전"), false);
+  }
+  assert.equal(files[0].includes("월 9,900원"), true);
+});
