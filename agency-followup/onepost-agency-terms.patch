+const fs = require("fs");
+const path = require("path");
+const test = require("node:test");
+const assert = require("node:assert/strict");
+
+const terms = fs.readFileSync(path.join(__dirname, "..", "public", "terms.html"), "utf8");
+const refund = fs.readFileSync(path.join(__dirname, "..", "public", "refund.html"), "utf8");
+
+test("draft agency clauses keep tool terms and leave refund undecided", () => {
+  for (const text of [terms, refund]) {
+    assert.equal(text.includes("법률 자문이 아닙니다"), true);
+    assert.equal(text.includes("다음 달까지만 이월"), true);
+    assert.equal(text.includes("최소 3개월"), true);
+    assert.equal(text.includes("자동결제는 준비 중"), true);
+    assert.equal(text.includes("환불: ［미정］"), true);
+    assert.equal(text.includes("위약금: ［미정］"), true);
+    assert.equal(text.includes("아직 고르지 않았습니다"), true);
+    assert.equal(text.includes("전자상거래법"), true);
+  }
+  assert.equal(terms.includes("출시 요금은 월 9,900원입니다."), true);
+  assert.equal(refund.includes("출시 요금 월 9,900원"), true);
+});
