+const fs = require("fs");
+const path = require("path");
+const test = require("node:test");
+const assert = require("node:assert/strict");
+
+const root = path.join(__dirname, "..");
+const { finiteStat } = require("../lib/insights");
+const {
+  buildForStore,
+  channelAnalysisHttpResult,
+  readConnections,
+} = require("../lib/channel-analysis");
+
+const BANNED = ["성장", "증가", "감소", "추세", "전월", "전주"];
+
+function metric(analysis, platform, key) {
+  const channel = analysis.channels.find((item) => item.platform === platform);
+  return channel.metrics.find((item) => item.key === key);
+}
+
+test("collector keeps null and numeric zero apart", () => {
+  assert.equal(finiteStat(undefined), null);
+  assert.equal(finiteStat(null), null);
+  assert.equal(finiteStat(""), null);
+  assert.equal(finiteStat("nope"), null);
+  assert.equal(finiteStat(0), 0);
+  assert.equal(finiteStat("0"), 0);
+  assert.equal(finiteStat("12"), 12);
+});
+
+test("current source scopes and collectors match the analysis catalog", () => {
+  const server = fs.readFileSync(path.join(root, "server.js"), "utf8");
+  const insights = fs.readFileSync(path.join(root, "lib/insights.js"), "utf8");
+  assert.match(server, /const TIKTOK_SCOPES = \["user\.info\.basic", "video\.upload", "video\.publish"\]/);
+  assert.equal(server.includes("user.info.stats"), false);
+  assert.match(server, /instagram_business_basic/);
+  assert.equal(server.includes("instagram_business_manage_insights"), false);
+  assert.match(server, /threads_manage_insights/);
+  assert.match(server, /pages_read_engagement/);
+  assert.match(insights, /INSIGHTS_META_ENABLED/);
+  assert.match(insights, /youtube: \{ file: "youtube\.json"/);
+  assert.equal(insights.includes("facebook: {"), false);
+  const routeAt = server.indexOf('app.get("/api/stores/:storeId/channel-analysis"');
+  assert.notEqual(routeAt, -1);
+  const routeBody = server.slice(routeAt, server.indexOf("// ---- 트렌드", routeAt));
+  assert.match(routeBody, /channelAnalysisHttpResult/);
+  assert.equal(routeBody.includes("req.query"), false);
+  assert.equal(routeBody.includes(["RED", "ACTED_"].join("")), false);
+});
+
