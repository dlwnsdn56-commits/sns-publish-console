+    reason: "네이버 블로그는 조회 스냅샷 대상이 아닙니다.",
+  },
+];
+
+const METRICS = {
+  youtube: [
+    { key: "views", label: "누적 조회수", definition: "channels.list statistics.viewCount. 채널에 쌓인 조회수입니다. 응답에 필드가 없으면 null 로 저장합니다." },
+    { key: "followers", label: "구독자 수", definition: "statistics.subscriberCount. hiddenSubscriberCount 가 참이면 null 입니다." },
+    { key: "videos", label: "동영상 수", definition: "statistics.videoCount." },
+  ],
+  tiktok: [
+    { key: "followers", label: "팔로워 수", definition: "user.info follower_count. user.info.stats 권한이 필요합니다.", scope: "user.info.stats" },
+    { key: "likes", label: "받은 좋아요", definition: "user.info likes_count. user.info.stats 권한이 필요합니다.", scope: "user.info.stats" },
+    { key: "videos", label: "동영상 수", definition: "user.info video_count. 그 값이 없으면 video.list 로 센 개수를 저장합니다.", scope: "user.info.stats" },
+    { key: "views", label: "영상 조회수 합계", definition: "video.list view_count 의 합입니다. 누락된 view_count 가 있으면 합계를 만들지 않고 null 입니다. video.list 권한이 필요합니다.", scope: "video.list" },
+  ],
+  instagram: [
+    { key: "followers", label: "팔로워 수", definition: "graph.instagram.com /me followers_count." },
+    { key: "videos", label: "미디어 수", definition: "graph /me media_count. 동영상 수만 의미하지 않습니다." },
+    { key: "dayViews", label: "하루 조회", definition: "insights metric views, period day, metric_type total_value. 누적 조회수가 아닙니다. instagram_business_manage_insights 가 필요합니다.", scope: "instagram_business_manage_insights" },
+  ],
+  threads: [
+    { key: "followers", label: "팔로워 수", definition: "threads_insights followers_count 의 total_value.", scope: "threads_manage_insights" },
+    { key: "dayViews", label: "기간 조회 합", definition: "threads_insights views. since 는 약 하루 전이고 values 를 합산합니다. 누적 조회수가 아닙니다. 값이 빠진 항목이 있으면 null 입니다.", scope: "threads_manage_insights" },
+  ],
+};
+
+const RECONNECT_REASONS = new Set([
+  "refresh_failed",
+  "access_token_invalid",
+  "invalid_grant",
+  "unauthorized",
+  "http_401",
+  "autherror",
+]);
+
+const NUMBER_KEYS = ["views", "followers", "videos", "likes", "dayViews"];
+
+function cleanText(value) {
+  if (typeof value !== "string") return null;
+  const text = value.trim();
+  return text ? text.slice(0, 300) : null;
+}
+
+function finiteNumber(value) {
+  return typeof value === "number" && Number.isFinite(value) ? value : null;
+}
+
+function snapKey(email, clientId, platform) {
+  return `${String(email || "").toLowerCase()}|${clientId}|${platform}`;
+}
+
+function readSnapshotFile(filePath = SNAP_PATH) {
+  try {
+    const data = JSON.parse(fs.readFileSync(filePath, "utf8"));
+    if (!data || typeof data !== "object" || !data.days || typeof data.days !== "object") {
+      return { version: 1, days: {}, lastRunAt: null };
+    }
+    return data;
+  } catch {
+    return { version: 1, days: {}, lastRunAt: null };
+  }
+}
+
+function accountFromConnection(platform, rec) {
+  if (!rec || typeof rec !== "object") return null;
+  if (platform === "youtube") {
+    const displayName = cleanText(rec.channelTitle);
+    const id = cleanText(rec.channelId);
+    if (!displayName && !id) return null;
+    return { displayName, id };
+  }
+  if (platform === "instagram" || platform === "threads") {
+    const displayName = cleanText(rec.username);
+    const id = cleanText(rec.userId);
+    if (!displayName && !id) return null;
+    return { displayName, id };
+  }
+  if (platform === "facebook") {
+    const displayName = cleanText(rec.pageName);
+    const id = cleanText(rec.pageId);
+    if (!displayName && !id) return null;
+    return { displayName, id };
+  }
+  if (platform === "tiktok") {
+    const displayName = cleanText(rec.displayName) || cleanText(rec.username);
+    const id = cleanText(rec.openId);
+    if (!displayName && !id) return null;
+    return { displayName, id };
+  }
+  if (platform === "x") {
+    const displayName = cleanText(rec.username) || cleanText(rec.displayName);
+    const id = cleanText(rec.userId);
+    if (!displayName && !id) return null;
+    return { displayName, id };
+  }
+  if (platform === "blogger") {
+    const displayName = cleanText(rec.blogTitle);
+    const id = cleanText(rec.blogId);
+    if (!displayName && !id) return null;
+    return { displayName, id };
+  }
+  return null;
+}
+
+function hasToken(platform, rec) {
+  if (!rec || typeof rec !== "object") return false;
+  if (platform === "facebook") return Boolean(rec.pageAccessToken || rec.accessToken);
+  return Boolean(rec.accessToken || rec.refreshToken);
+}
+
+function readConnections(email, clientId) {
+  const stores = {
+    youtube: require("./youtube-store"),
+    instagram: require("./instagram-store"),
+    facebook: require("./facebook-store"),
+    threads: require("./threads-store"),
+    tiktok: require("./tiktok-store"),
+    x: require("./x-store"),
+    blogger: require("./blogger-store"),
+  };
+  const out = {};
+  for (const [platform, store] of Object.entries(stores)) {
+    const rec = store.getConnection(email, clientId);
+    out[platform] = {
+      hasToken: hasToken(platform, rec),
+      account: accountFromConnection(platform, rec),
+    };
+  }
+  return out;
+}
+
+function rowHasNumbers(row) {
+  if (!row) return false;
+  return NUMBER_KEYS.some((key) => finiteNumber(row[key]) != null);
+}
+
+function historyFor(snapshots, email, clientId, platform) {
+  const key = snapKey(email, clientId, platform);
+  const dates = Object.keys((snapshots && snapshots.days) || {}).sort();
+  let latest = null;
+  let previous = null;
+  let failureAfter = null;
+  for (const date of dates) {
+    const row = snapshots.days[date] && snapshots.days[date][key];
+    if (!row || row.email && row.email !== String(email).toLowerCase()) continue;
+    if (row.clientId && row.clientId !== clientId) continue;
+    const failure = row.error && !rowHasNumbers(row);
+    if (failure) {
+      if (!latest || date >= latest.date) failureAfter = { date, reason: cleanText(row.error) };
+      continue;
+    }
+    if (latest) previous = latest;
+    latest = { date, row };
+    if (failureAfter && failureAfter.date < date) failureAfter = null;
+  }
+  return { latest, previous, failureAfter };
+}
+
+function isReconnectReason(reason) {
+  return RECONNECT_REASONS.has(String(reason || "").toLowerCase());
+}
+
+function connectionState(platform, conn, failureAfter) {
+  if (!platform.tracked) return { code: "not_tracked", label: "연결 계정 확인 대상 아님" };
+  const account = conn && conn.account;
+  const token = Boolean(conn && conn.hasToken);
+  const reason = failureAfter && failureAfter.reason;
+  if (token && account && isReconnectReason(reason)) return { code: "reconnect", label: "재연결 필요" };
+  if (!token && account) return { code: "reconnect", label: "재연결 필요" };
+  if (token && account) return { code: "connected", label: "연결 계정 확인" };
+  if (token && !account) return { code: "connected_without_identity", label: "토큰은 있으나 계정 식별자가 없습니다" };
+  return { code: "no_account", label: "연결 안 됨" };
+}
+
+function reviewState(platform, metaEnabled) {
+  if (!platform.meta) return { code: "not_applicable", label: "메타 검토 대상 아님" };
+  if (!metaEnabled) return { code: "pending_review", label: "메타 인사이트 수집이 꺼져 있음" };
+  return { code: "enabled", label: "메타 인사이트 수집이 켜져 있음" };
+}
+
+function metricRows(platform, latest, previous, metaEnabled) {
+  const defs = METRICS[platform.id] || [];
+  const missing = new Set((latest && latest.row && latest.row.missingScope) || []);
+  return defs.map((def) => {
+    const raw = latest && latest.row ? latest.row[def.key] : undefined;
+    const value = finiteNumber(raw);
+    const prevRaw = previous && previous.row ? previous.row[def.key] : undefined;
+    const previousValue = finiteNumber(prevRaw);
+    let state = "unavailable";
+    let unavailableReason = "스냅샷에 숫자가 없습니다";
+    if (value != null) {
+      state = "available";
+      unavailableReason = null;
+    } else if (platform.meta && !metaEnabled && !latest) {
+      unavailableReason = "INSIGHTS_META_ENABLED 가 꺼져 있어 수집하지 않았습니다";
+    } else if (def.scope && missing.has(def.scope)) {
+      unavailableReason = `${def.scope} 권한이 없어 숫자가 없습니다`;
+    } else if (raw != null && value == null) {
+      unavailableReason = "숫자 값이 아닙니다";
+    }
+    return {
+      key: def.key,
+      label: def.label,
+      definition: def.definition,
+      value: state === "available" ? value : null,
+      previousValue,
+      state,
+      unavailableReason,
+    };
+  });
+}
+
+function buildSummary(storeName, channels) {
+  const available = [];
+  let nullMetricCount = 0;
+  let connectedCount = 0;
+  for (const channel of channels) {
+    if (channel.connection.code === "connected" || channel.connection.code === "reconnect" || channel.connection.code === "connected_without_identity") {
+      connectedCount += 1;
+    }
+    for (const metric of channel.metrics) {
+      if (metric.state === "available") {
+        available.push({
+          platform: channel.platform,
+          label: channel.label,
+          key: metric.key,
+          metricLabel: metric.label,
+          value: metric.value,
+          definition: metric.definition,
+        });
+      } else nullMetricCount += 1;
+    }
+  }
+  const parts = [`${storeName}의 채널 분석입니다.`];
+  parts.push(`연결 상태가 확인된 채널은 ${connectedCount}곳입니다.`);
+  if (!available.length) parts.push("스냅샷에서 확인할 수 있는 숫자는 없습니다.");
+  else {
+    const bits = available.map((metric) => `${metric.label} ${metric.metricLabel} ${metric.value} (정의: ${metric.definition})`);
+    parts.push(`확인된 지표는 ${bits.join(", ")} 입니다.`);
+  }
+  if (nullMetricCount) parts.push(`숫자 값이 없는 지표 ${nullMetricCount}개는 합산에 넣지 않았습니다.`);
+  parts.push("표시 값은 이 가게의 연결 기록과 인사이트 스냅샷에 있는 숫자입니다.");
+  return { text: parts.join(" "), availableMetrics: available, nullMetricCount, connectedCount };
+}
+
+function buildForStore({ email, client, metaEnabled = false, snapshots, connections, generatedAt }) {
+  if (!email) throw new Error("email is required");
+  if (!client || !client.id) throw new Error("client is required");
+  const snaps = snapshots || readSnapshotFile();
+  const conns = connections || readConnections(email, client.id);
+  const channels = PLATFORMS.map((platform) => {
+    const conn = conns[platform.id] || { hasToken: false, account: null };
+    const history = platform.collector ? historyFor(snaps, email, client.id, platform.id) : { latest: null, previous: null, failureAfter: null };
+    const connection = connectionState(platform, conn, history.failureAfter);
+    const review = reviewState(platform, metaEnabled);
+    const metrics = platform.collector ? metricRows(platform, history.latest, history.previous, metaEnabled) : [];
+    const availableCount = metrics.filter((metric) => metric.state === "available").length;
+    let providerState = "unavailable";
+    let providerStateReason = platform.reason;
+    if (!platform.collector) providerState = "unsupported";
+    else if (review.code === "pending_review" && availableCount === 0) providerState = "review_pending";
+    else if (connection.code === "reconnect") providerState = "reconnect";
+    else if (connection.code === "no_account") providerState = "not_connected";
+    else if (availableCount > 0) providerState = "available";
+    if (history.failureAfter && history.failureAfter.reason) {
+      providerStateReason += ` 최근 수집 오류: ${history.failureAfter.reason}.`;
+    }
+    if (history.latest && history.latest.row && history.latest.row.missingScope) {
+      providerStateReason += ` 없는 권한: ${history.latest.row.missingScope.join(", ")}.`;
+    }
+    return {
+      platform: platform.id,
+      label: platform.label,
+      collector: platform.collector,
+      connection,
+      review,
+      account: conn.account
+        ? { displayName: cleanText(conn.account.displayName), id: cleanText(conn.account.id) }
+        : null,
+      snapshotAccount: history.latest && history.latest.row ? cleanText(history.latest.row.account) : null,
+      snapshotAccountId: history.latest && history.latest.row ? cleanText(history.latest.row.accountId) : null,
+      snapshotDate: history.latest ? history.latest.date : null,
+      snapshotAt: history.latest && history.latest.row ? cleanText(history.latest.row.at) : null,
+      previousDate: history.previous ? history.previous.date : null,
+      lastError: history.failureAfter ? history.failureAfter.reason : (history.latest && history.latest.row && cleanText(history.latest.row.lastError)) || null,
+      missingScope: (history.latest && history.latest.row && history.latest.row.missingScope) || null,
+      providerState,
+      providerStateReason,
+      metrics,
+    };
+  });
+  return {
+    storeId: client.id,
+    storeName: client.name || client.id,
+    email: String(email).toLowerCase(),
+    generatedAt: generatedAt || new Date().toISOString(),
+    metaEnabled: metaEnabled === true,
+    summary: buildSummary(client.name || client.id, channels),
+    channels,
+  };
+}
+
+function channelAnalysisHttpResult({ sessionEmail, storeId, getClient, build }) {
+  if (!sessionEmail) return { status: 401, body: { error: "로그인이 필요합니다." } };
+  const client = getClient(sessionEmail, storeId);
+  if (!client) return { status: 404, body: { error: "가게를 찾을 수 없습니다." } };
+  return { status: 200, body: build({ email: sessionEmail, client }) };
+}
+
+module.exports = {
+  PLATFORMS,
+  METRICS,
+  readSnapshotFile,
+  readConnections,
+  buildForStore,
+  channelAnalysisHttpResult,
+  finiteNumber,
+};
