+  },
+  {
+    id: "youtube-community",
+    label: "유튜브 커뮤니티",
+    collector: false,
+    meta: false,
+    tracked: false,
+    reason: "유튜브 커뮤니티는 조회 스냅샷 대상이 아닙니다.",
+  },
+  {
+    id: "naver-clip",
+    label: "네이버 클립",
+    collector: false,
+    meta: false,
+    tracked: false,
+    reason: "네이버 클립은 조회 스냅샷 대상이 아닙니다.",
+  },
+  {
+    id: "naver-blog",
+    label: "네이버 블로그",
+    collector: false,
+    meta: false,
