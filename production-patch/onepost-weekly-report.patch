+  }
+  const sums = [];
+  for (const [definition, items] of groups) {
+    if (items.length < 2) continue;
+    const sameWindow = items.every((item) => item.fromDate === items[0].fromDate && item.toDate === items[0].toDate);
+    if (!sameWindow) continue;
+    sums.push({
+      label: "조회 합계(중복 포함)",
+      definition,
+      fromDate: items[0].fromDate,
+      toDate: items[0].toDate,
