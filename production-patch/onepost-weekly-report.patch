+const METRICS = {
+  youtube: [
+    { key: "views", label: "누적 조회수", unit: "회", kind: "cumulative", definition: "channels.list statistics.viewCount. 기간 발생 조회수가 아닙니다.", comparable: "youtube_channel_view_count" },
+    { key: "followers", label: "누적 구독자", unit: "명", kind: "cumulative", definition: "statistics.subscriberCount. 기준 시각의 누적값입니다.", comparable: null },
