+test("pdf contains every channel, the disclaimer, and more than one page", async () => {
+  const report = buildWeeklyReport({
+    email: EMAIL,
+    client: { id: "store-shape", name: "합성가게" },
+    snapshots: {
+      version: 1,
+      lastRunAt: "2026-11-05T15:21:01.000Z",
+      days: {
+        "2026-11-04": { [`${EMAIL}|store-shape|youtube`]: yt("2026-11-04", 100, 0) },
+        "2026-11-06": { [`${EMAIL}|store-shape|youtube`]: yt("2026-11-06", 140, 12) },
+      },
+    },
+    connections: {
+      youtube: { hasToken: true, account: { displayName: "합성채널", id: "yt-synthetic" } },
+      tiktok: { hasToken: true, account: { displayName: "합성틱톡", id: "tt-synthetic" } },
+    },
+    jobs: [],
+    end: "2026-11-06",
+    days: 7,
+    generatedAt: "2026-11-06T05:20:00.000Z",
+    fixtureBanner: "합성 예시. 운영 스냅샷이 아닙니다.",
+  });
+  const pdf = await renderWeeklyReportPdf(report);
+  const file = path.join(os.tmpdir(), "onepost-weekly-sample.pdf");
+  fs.writeFileSync(file, pdf);
+  const info = execFileSync("pdfinfo", [file], { encoding: "utf8" });
+  const pages = Number((info.match(/Pages:\s+(\d+)/) || [])[1]);
+  assert.ok(pages >= 2, info);
+  const text = execFileSync("pdftotext", ["-layout", file, "-"], { encoding: "utf8" });
+  assert.equal(text.includes(DISCLAIMER), true);
+  assert.equal(text.includes("합성가게"), true);
+  assert.equal(text.includes("YouTube"), true);
+  assert.equal(text.includes("TikTok"), true);
+  assert.equal(text.includes("네이버 블로그"), true);
+  assert.equal(text.includes("7일 델타와 이전 주 비교는 만들 수 없습니다."), true);
+  assert.equal(text.includes("OTHER-SECRET"), false);
+  assert.equal(text.includes("%"), false);
+  const page2 = execFileSync("pdftotext", ["-f", "2", "-l", "2", "-layout", file, "-"], { encoding: "utf8" });
+  assert.ok(page2.trim().length > 40, page2);
+});
