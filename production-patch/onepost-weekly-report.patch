+    }
+    return {
+      platform: platform.id,
+      label: platform.label,
+      collector: platform.collector,
+      status,
+      account: accountOf(conns[platform.id]),
+      metrics,
+      posts: { available: false, reason: "게시물별 조회수는 저장되어 있지 않습니다. 막대그래프를 그리지 않습니다." },
+    };
+  });
+  const sevenDayDeltaEligible = window.days === 7 && channels.some((channel) => channel.metrics.some((metric) => metric.windowBoundaryDelta.eligible));
+  const priorWeekEligible = channels.some((channel) => channel.metrics.some((metric) => metric.comparison.eligible));
+  const report = {
+    storeId: client.id,
+    storeName: client.name || client.id,
+    email: String(email).toLowerCase(),
+    generatedAt: generatedAt || new Date().toISOString(),
+    timeZone: "Asia/Seoul",
+    disclaimer: DISCLAIMER,
+    fixtureBanner: fixtureBanner || null,
+    period: { start: window.start, end: window.end, days: window.days, priorStart: window.priorStart, priorEnd: window.priorEnd },
+    lastCollectedAt: latestCollectedAt(snaps, email, client.id),
+    coverage: {
+      windowDays: window.dates.length,
+      observedDates,
+      missingDates: window.dates.filter((date) => !observedDates.includes(date)),
+      sevenDayDeltaEligible,
+      priorWeekEligible,
+    },
