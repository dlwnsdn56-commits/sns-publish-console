+const fs = require("fs");
+const path = require("path");
+const PDFDocument = require("pdfkit");
+
+const FONT = path.join(__dirname, "..", "assets", "fonts", "NotoSansKR-Regular.ttf");
+
+function fontAvailable() {
+  return fs.existsSync(FONT);
+}
+
+function renderWeeklyReportPdf(report) {
+  if (!fontAvailable()) {
+    const err = new Error("한국어 글꼴 파일이 없습니다.");
+    err.code = "FONT_MISSING";
+    throw err;
+  }
+  return new Promise((resolve, reject) => {
+    const doc = new PDFDocument({ size: "A4", margin: 40, info: { Title: "원포스트 주간 리포트" } });
+    const chunks = [];
+    doc.on("data", (chunk) => chunks.push(chunk));
+    doc.on("end", () => resolve(Buffer.concat(chunks)));
+    doc.on("error", reject);
+    doc.registerFont("kr", FONT);
+    doc.font("kr");
+    const left = 40;
+    const width = 515;
+    let y = 40;
+
+    function ensure(height) {
+      if (y + height <= 800) return;
+      doc.addPage();
+      y = 40;
+      doc.fontSize(9).fillColor("#666666").text(`${report.storeName} · ${report.period.start} ~ ${report.period.end} Asia/Seoul`, left, y, { width });
+      y = doc.y + 8;
+    }
+
+    function text(value, size, color) {
+      ensure(size + 8);
+      doc.fontSize(size).fillColor(color || "#111111").text(String(value), left, y, { width });
+      y = doc.y + 4;
+    }
+
+    text(report.fixtureBanner || "운영 데이터 리포트", 10, "#8a5a00");
+    text(report.storeName, 18);
+    text(`기간 ${report.period.start} ~ ${report.period.end} (Asia/Seoul, ${report.period.days}일)`, 11);
+    text(`마지막 수집 ${report.lastCollectedAt || "없음"}`, 10, "#444444");
+    text(`이 문서 생성 ${report.generatedAt}`, 10, "#444444");
+    text(report.disclaimer, 10);
+    text(`수집이 있는 날 ${report.coverage.observedDates.join(", ") || "없음"}`, 10);
+    text(`수집이 없는 날 ${report.coverage.missingDates.join(", ") || "없음"}`, 10);
+    text(report.coverage.sevenDayDeltaEligible ? "7일 경계 비교를 계산했습니다." : "7일 델타와 이전 주 비교는 만들 수 없습니다.", 10);
+    for (const line of report.suggestions) text(line, 10);
+    text(`발행 작업 ${report.publishing.uploadJobs}건 · 채널 작업 ${report.publishing.channelPublishTasks}건 · 동영상 1개 업로드 ${report.publishing.singleVideoUploads}건`, 10);
+    text(report.publishing.identity, 9, "#444444");
+    if (!report.viewSums.length) text("같은 정의로 겹치는 채널 조회 합계는 없습니다.", 10);
+    for (const sum of report.viewSums) text(`${sum.label} ${sum.value} (${sum.definition}, ${sum.fromDate}~${sum.toDate})`, 10);
+
+    for (const channel of report.channels) {
+      ensure(36);
+      y += 8;
+      text(channel.label, 14);
+      text(`${channel.status.label}${channel.account && channel.account.displayName ? " · " + channel.account.displayName : ""}`, 10);
+      text(channel.posts.reason, 9, "#444444");
+      if (!channel.metrics.length) {
+        text("표시할 조회 지표 정의가 없습니다.", 10);
+        continue;
+      }
+      for (const metric of channel.metrics) {
+        text(`${metric.label} (${metric.unit}) ${metric.definition}`, 9, "#333333");
+        if (metric.asOf) text(`기준 ${metric.asOf.date} 값 ${metric.asOf.value} · ${metric.asOf.state}`, 10);
+        else text("이 기간의 기준 숫자가 없습니다.", 10);
+        if (metric.kind === "period_occurring") {
+          text(metric.periodOccurring.eligible ? metric.periodOccurring.label : metric.periodOccurring.reason, 10);
+        } else if (metric.observedSpan.eligible) {
+          text(`관측 구간 차이 ${metric.observedSpan.difference} (${metric.observedSpan.label}, ${metric.observedSpan.spanDays}일 간격). 빠진 날을 잇지 않습니다.`, 10);
+        } else {
+          text(metric.observedSpan.reason, 10);
+        }
+        text(metric.windowBoundaryDelta.eligible ? `기간 경계 차이 ${metric.windowBoundaryDelta.label}` : metric.windowBoundaryDelta.reason, 10);
+        text(metric.comparison.eligible ? `이전 주 ${metric.comparison.text}` : metric.comparison.text, 10);
+        const shown = metric.cells.filter((cell) => cell.state !== "absent").slice(0, 12);
+        if (!shown.length) text("표에 넣을 수집 행이 없습니다.", 9, "#444444");
+        for (const cell of shown) {
+          text(`${cell.date} ${cell.state} ${cell.value == null ? "값 없음" : cell.value}${cell.reason ? " " + cell.reason : ""}`, 8, "#333333");
+        }
+        if (metric.series.length) {
+          ensure(70);
+          drawSeries(doc, metric.series, left, y, width, 56);
+          y += 64;
+        }
+      }
+    }
+    doc.end();
+  });
+}
+
+function drawSeries(doc, points, x, y, width, height) {
+  const values = points.map((point) => point.value);
+  const min = Math.min(...values);
+  const max = Math.max(...values);
+  const span = max - min || 1;
+  doc.save();
+  doc.rect(x, y, width, height).strokeColor("#dddddd").stroke();
+  const t0 = Date.parse(points[0].date + "T00:00:00Z");
+  const t1 = Date.parse(points[points.length - 1].date + "T00:00:00Z");
+  const spanT = Math.max(1, t1 - t0);
+  let prev = null;
+  for (let i = 0; i < points.length; i++) {
+    const fraction = points.length === 1 ? 0.5 : (Date.parse(points[i].date + "T00:00:00Z") - t0) / spanT;
+    const px = x + 4 + fraction * (width - 8);
+    const py = y + height - 6 - ((points[i].value - min) / span) * (height - 12);
+    doc.circle(px, py, 2).fillColor("#355c8c").fill();
+    if (prev && !points[i].gapBefore) {
+      doc.moveTo(prev.x, prev.y).lineTo(px, py).strokeColor("#355c8c").stroke();
+    }
+    prev = { x: px, y: py };
+  }
+  doc.restore();
+}
+
+module.exports = { renderWeeklyReportPdf, fontAvailable, FONT };
