+const fs = require("fs");
+const path = require("path");
+const PDFDocument = require("pdfkit");
+const FONT = path.join(__dirname, "..", "assets", "fonts", "NotoSansKR-Regular.ttf");
+
+function fontAvailable() {
+  return fs.existsSync(FONT);
+}
+
+function renderWeeklyReportPdf(report) {
+  if (!fontAvailable()) {
+    const err = new Error("한국어 글꼴 파일이 없습니다.");
+    err.code = "FONT_MISSING";
+    throw err;
+  }
+  return new Promise((resolve, reject) => {
+    const doc = new PDFDocument({ size: "A4", margin: 40, info: { Title: "원포스트 주간 리포트" } });
+    const chunks = [];
+    doc.on("data", (chunk) => chunks.push(chunk));
+    doc.on("end", () => resolve(Buffer.concat(chunks)));
+    doc.on("error", reject);
+    doc.registerFont("kr", FONT);
+    doc.font("kr");
+    const left = 40;
+    const width = 515;
+    const bottom = 780;
+    let y = 40;
+
+    function runningHeader() {
+      doc.font("kr").fontSize(9).fillColor("#666666");
+      doc.text(`${report.storeName} · ${report.period.start} ~ ${report.period.end} · 한국시간`, left, 28, { width });
+      y = 48;
+    }
+
+    function newPage() {
+      doc.addPage();
+      runningHeader();
+    }
+
+    function ensure(height) {
+      if (y + height <= bottom) return;
+      newPage();
+    }
+
+    function text(value, size, color) {
+      ensure(size + 10);
+      doc.font("kr").fontSize(size).fillColor(color || "#111111");
+      doc.text(String(value), left, y, { width });
+      y = doc.y + 4;
+    }
+
+    const view = report.presentation;
+    text(report.fixtureBanner || "주간 리포트", 10, "#8a5a00");
+    text(report.storeName, 20);
+    text(`${report.period.start} ~ ${report.period.end} · 한국시간 · ${report.period.days}일`, 12);
+    text(`마지막 수집 ${report.lastCollectedAtKst || "없음"}`, 11);
+    text(`문서 작성 ${report.generatedAtKst || ""}`, 11);
+    text(report.coverage.headline, 13);
+    text(report.disclaimer, 10);
+    text(`올린 작업 ${report.publishing.uploadJobs}건 · 채널에 올린 횟수 ${report.publishing.channelPublishTasks}건`, 11);
+    if (!view.cards.length) text("이 기간에 표시할 숫자가 없습니다.", 12);
+    for (const card of view.cards) {
+      text(`${card.channel} ${card.label}  ${card.value}`, 12);
+      text(`${card.sub}${card.span ? " · " + card.span : ""}`, 9, "#444444");
+    }
+    for (const sum of report.viewSums) text(`${sum.label} ${sum.value}`, 11);
+    text("숫자가 있는 채널은 다음 장에 있습니다.", 10, "#444444");
+
+    if (view.detailChannels.length) {
+      newPage();
+      text("채널", 16);
+      for (const channel of view.detailChannels) {
+        if (y > 560) newPage();
+        text(`${channel.label}${channel.account && channel.account.displayName ? " · " + channel.account.displayName : ""}`, 14);
+        text(channel.status.label, 10, "#444444");
+        text(channel.posts.reason, 10);
+        for (const metric of channel.shownMetrics) {
+          text(`${metric.label} ${metric.asOf ? metric.asOf.value + metric.unit : ""} · ${metric.asOf ? metric.asOf.stateLabel : ""}`, 11);
+          if (metric.customerSpan) text(metric.customerSpan, 9, "#444444");
+          if (metric.comparison.eligible) text(`전주 ${metric.comparison.text}`, 10);
+          ensure(130);
+          drawChart(doc, metric, left, y, width, 108);
+          y += 116;
+        }
+      }
+    }
+    if (view.statusRows.length) {
+      if (y + 28 + view.statusRows.length * 16 > bottom) newPage();
+      text("데이터 현황", 14);
+      for (const row of view.statusRows) text(`${row.label} · ${row.note}`, 10);
+    }
+    if (y > 640) newPage();
+    text("집계 기준", 12);
+    for (const line of view.criteria) text(line, 8, "#444444");
+    doc.end();
+  });
+}
+
+function drawChart(doc, metric, x, y, width, height) {
+  const cells = metric.cells;
+  const plotX = x + 48;
+  const plotW = width - 72;
+  const plotY = y + 16;
+  const plotH = height - 42;
+  const numeric = cells.filter((cell) => cell.state === "available" || cell.state === "actual_zero");
+  const min = Math.min(...numeric.map((cell) => cell.value));
+  const max = Math.max(...numeric.map((cell) => cell.value));
+  const pad = (max - min) * 0.18 || 1;
+  const yMin = min - pad;
+  const yMax = max + pad;
+  const span = yMax - yMin;
+  doc.save();
+  doc.font("kr").fontSize(8).fillColor("#333333");
+  doc.text(`${metric.label} (${metric.unit})`, x, y, { width });
+  doc.fillColor("#333333").text(String(max), x, plotY - 2, { width: 44, align: "right" });
+  doc.text(String(min), x, plotY + plotH - 8, { width: 44, align: "right" });
+  doc.rect(plotX, plotY, plotW, plotH).strokeColor("#dddddd").stroke();
+  const n = Math.max(cells.length, 1);
+  const coords = [];
+  cells.forEach((cell, index) => {
+    const px = plotX + (n === 1 ? plotW / 2 : (index / (n - 1)) * plotW);
+    const plotted = cell.state === "available" || cell.state === "actual_zero";
+    const py = plotted ? plotY + plotH - ((cell.value - yMin) / span) * plotH : null;
+    coords.push({ cell, px, py, plotted });
+    doc.moveTo(px, plotY + plotH).lineTo(px, plotY + plotH + 3).strokeColor("#bbbbbb").stroke();
+  });
+  let prev = null;
+  for (const point of coords) {
+    if (!point.plotted) {
+      prev = null;
+      continue;
+    }
+    doc.circle(point.px, point.py, 2.5).fillColor("#355c8c").fill();
+    if (prev && addOneDay(prev.cell.date) === point.cell.date) {
+      doc.moveTo(prev.px, prev.py).lineTo(point.px, point.py).strokeColor("#355c8c").lineWidth(1.2).stroke();
+    }
+    prev = point;
+  }
+  doc.font("kr").fontSize(7).fillColor("#444444");
+  const step = cells.length > 14 ? 7 : cells.length > 8 ? 2 : 1;
+  cells.forEach((cell, index) => {
+    if (index % step !== 0 && index !== cells.length - 1) return;
+    const px = coords[index].px;
+    doc.text(cell.date.slice(5), px - 14, plotY + plotH + 6, { width: 32, align: "center" });
+  });
+  doc.text("점 없는 눈금은 수집 없음이며 0이 아닙니다. 선은 다음 날로 이어질 때만 그립니다.", x, y + height - 12, { width });
+  doc.restore();
+}
+
+function addOneDay(date) {
+  return new Date(Date.parse(date + "T00:00:00Z") + 24 * 60 * 60 * 1000).toISOString().slice(0, 10);
+}
+
+module.exports = { renderWeeklyReportPdf, fontAvailable, FONT };
