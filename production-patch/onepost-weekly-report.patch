+
+function publishingReport(jobs, email, clientId, window) {
+  const want = String(email || "").toLowerCase();
+  const mine = (jobs || []).filter((job) => {
+    if (!job || job.clientId !== clientId) return false;
+    if (job.userEmail && String(job.userEmail).toLowerCase() !== want) return false;
+    const created = job.createdAt ? kstDate(Date.parse(job.createdAt)) : null;
+    return created && created >= window.start && created <= window.end;
+  });
+  const tasks = mine.flatMap((job) => job.tasks || []);
+  const singleVideoJobs = mine.filter((job) => job.mediaType === "video" && Array.isArray(job.files) && job.files.length === 1).length;
+  return {
+    uploadJobs: mine.length,
+    channelPublishTasks: tasks.length,
+    singleVideoUploads: singleVideoJobs,
+    identity: "같은 영상인지는 파일 내용으로 구분하지 못했습니다. 올린 작업 수와 채널에 올린 횟수를 따로 적습니다.",
+  };
+}
+
+function channelHasNumbers(channel) {
+  return channel.metrics.some((metric) => metric.series.length > 0);
+}
+
+function coverageHeadline(period, coverage) {
+  const seen = coverage.observedDates.length;
+  if (period.days === 7) {
+    return coverage.priorWeekEligible
+      ? `${period.days}일 중 ${seen}일 수집 · 전주 비교를 표시합니다`
+      : `${period.days}일 중 ${seen}일 수집 · 전주 비교는 자료 부족`;
+  }
+  return coverage.priorWeekEligible
+    ? `${period.days}일 중 ${seen}일 수집 · 이전 기간 비교를 표시합니다`
+    : `${period.days}일 중 ${seen}일 수집 · 이전 기간 비교는 자료 부족`;
+}
+
+function statusNote(channel) {
+  if (channel.status.code === "unconnected") return "연결 안 됨";
