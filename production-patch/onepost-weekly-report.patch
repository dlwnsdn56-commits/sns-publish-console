+test("session store boundary and date query", () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "weekly-clients-"));
+  const root = path.join(__dirname, "..");
+  const dataDir = path.join(root, "data");
+  fs.mkdirSync(dataDir, { recursive: true });
+  fs.writeFileSync(
+    path.join(dataDir, "clients.json"),
+    JSON.stringify({
+      byUser: {
+        [EMAIL]: { clients: [{ id: "store-shape", name: "합성가게" }] },
+        [OTHER]: { clients: [{ id: "store-other", name: "다른가게" }] },
+      },
+    })
+  );
+  const clientStore = require("../lib/client-store");
+  const denied = weeklyReportHttpResult({
+    sessionEmail: EMAIL,
+    storeId: "store-other",
+    getClient: clientStore.getClient,
+    query: { days: "7", end: "2026-11-06" },
+    build: () => {
+      throw new Error("foreign store");
+    },
+  });
+  assert.equal(denied.status, 404);
+  const anon = weeklyReportHttpResult({
+    sessionEmail: "",
+    storeId: "store-shape",
+    getClient: clientStore.getClient,
+    query: {},
+    build: () => {
+      throw new Error("anon");
+    },
+  });
+  assert.equal(anon.status, 401);
+  const bad = weeklyReportHttpResult({
+    sessionEmail: EMAIL,
+    storeId: "store-shape",
+    getClient: clientStore.getClient,
+    query: { end: "11-06", days: "7" },
+    build: () => {
+      throw new Error("bad date");
+    },
+  });
+  assert.equal(bad.status, 400);
+  assert.equal(fs.existsSync(dir), true);
+});
