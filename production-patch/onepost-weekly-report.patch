+    ? comparisonText(priorBoundary, boundary)
+    : { eligible: false, text: "이전 주 비교는 7일 기간에서, 양쪽 기간의 시작일과 종료일에 같은 정의의 숫자가 있을 때만 계산합니다.", percent: null };
+  const occurring = metric.kind === "period_occurring" ? periodOccurring(currentSeries.cells, window.dates) : null;
