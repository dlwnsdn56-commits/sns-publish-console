+test("confirmed prior zero is shown as 0 to N and full-week boundaries can qualify", () => {
+  const days = {};
+  function put(date, views) {
+    days[date] = {
+      [`${EMAIL}|store-full|youtube`]: {
+        email: EMAIL,
+        clientId: "store-full",
+        platform: "youtube",
+        at: date + "T01:00:00.000Z",
+        views,
+        followers: 5,
+        videos: 1,
+        zeroConfirmed: true,
+      },
+    };
+  }
+  put("2026-11-01", 10);
+  put("2026-11-07", 10);
+  put("2026-11-08", 10);
+  put("2026-11-14", 15);
+  const report = buildWeeklyReport({
+    email: EMAIL,
+    client: { id: "store-full", name: "합성완전주" },
+    snapshots: { version: 1, days },
+    connections: { youtube: { hasToken: true, account: { displayName: "합성완전", id: "yt-full" } } },
+    jobs: [],
+    end: "2026-11-14",
+    days: 7,
+    fixtureBanner: "합성 예시. 운영 스냅샷이 아닙니다.",
+  });
+  const views = report.channels.find((ch) => ch.platform === "youtube").metrics.find((m) => m.key === "views");
+  assert.equal(views.windowBoundaryDelta.eligible, true);
+  assert.equal(views.windowBoundaryDelta.difference, 5);
+  assert.equal(views.comparison.eligible, true);
+  assert.equal(views.comparison.text, "0 -> 5");
+  assert.equal(views.comparison.percent, null);
+  assert.equal(report.coverage.sevenDayDeltaEligible, true);
+  assert.equal(report.fixtureBanner.includes("합성"), true);
+  const zeroRow = buildWeeklyReport({
+    email: EMAIL,
+    client: { id: "store-full", name: "합성완전주" },
+    snapshots: {
+      version: 1,
+      days: {
+        "2026-11-14": {
+          [`${EMAIL}|store-full|youtube`]: {
+            email: EMAIL,
+            clientId: "store-full",
+            platform: "youtube",
+            at: "2026-11-14T01:00:00.000Z",
+            views: 0,
+            followers: 0,
+            videos: 0,
+            zeroConfirmed: true,
+          },
+        },
+      },
+    },
+    connections: { youtube: { hasToken: true, account: { displayName: "합성완전", id: "yt-full" } } },
+    jobs: [],
+    end: "2026-11-14",
+    days: 7,
+  });
+  const confirmed = zeroRow.channels.find((ch) => ch.platform === "youtube").metrics.find((m) => m.key === "views");
+  assert.equal(confirmed.cells.find((c) => c.date === "2026-11-14").state, "actual_zero");
+});
