+function seriesFor(snapshots, email, clientId, platform, metric, dates) {
+  const points = [];
+  const cells = [];
+  for (const date of dates) {
+    const row = rowFor(snapshots, email, clientId, platform.id, date);
+    if (!row) {
+      cells.push({ date, state: "absent", value: null });
+      continue;
+    }
+    if (row.error && finiteNumber(row[metric.key]) == null) {
+      cells.push({ date, state: "collection_error", value: null, reason: String(row.error) });
