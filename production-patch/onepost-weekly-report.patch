+    { key: "followers", label: "누적 팔로워", unit: "명", kind: "cumulative", definition: "user.info follower_count. 기준 시각의 누적값입니다.", comparable: null },
+    { key: "likes", label: "누적 좋아요", unit: "개", kind: "cumulative", definition: "user.info likes_count.", comparable: null },
+    { key: "videos", label: "누적 동영상 수", unit: "개", kind: "cumulative", definition: "user.info video_count 또는 목록으로 센 개수입니다.", comparable: null },
+  ],
+  instagram: [
+    { key: "dayViews", label: "하루 조회", unit: "회", kind: "period_occurring", definition: "insights views, period day. 그 날짜에 값이 있을 때만 하루 발생 조회입니다.", comparable: null },
+    { key: "followers", label: "누적 팔로워", unit: "명", kind: "cumulative", definition: "graph /me followers_count. 기준 시각의 누적값입니다.", comparable: null },
+    { key: "videos", label: "미디어 수", unit: "개", kind: "cumulative", definition: "graph /me media_count.", comparable: null },
+  ],
+  threads: [
+    { key: "dayViews", label: "하루 조회", unit: "회", kind: "period_occurring", definition: "threads_insights views. 그 날짜에 값이 있을 때만 사용합니다.", comparable: null },
