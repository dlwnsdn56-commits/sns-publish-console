+/**
+ * Store weekly report from existing snapshots and publish jobs.
+ * Does not call providers and does not write snapshot files.
+ */
+const fs = require("fs");
+const path = require("path");
+
+const SNAP_PATH = path.join(__dirname, "..", "data", "insight-snapshots.json");
+const DAY = 24 * 60 * 60 * 1000;
+const DISCLAIMER = "확인 가능한 채널 데이터를 기준으로 작성했습니다. 미수집 항목은 0으로 계산하지 않았습니다.";
+const WINDOW_DAYS = new Set([7, 14, 28]);
+/** dcbe469 collector fix deployed 2026-11-06 13:27:49 KST. */
+const YT_ZERO_COERCION_UNTIL_MS = Date.parse("2026-11-06T04:27:49.000Z");
+const STATE_LABELS = {
+  available: "확인된 값",
+  actual_zero: "실제 0",
+  ambiguous_zero: "0으로 저장됨. 실제 0으로 단정하지 않음",
+  unavailable: "값 없음",
+  absent: "수집 없음",
+  permission_needed: "권한 필요",
+  collection_error: "수집 오류",
+  unknown: "알 수 없음",
+  connected: "연결됨",
+  unconnected: "연결 안 됨",
+  unsupported: "조회 스냅샷 대상 아님",
+};
+
+const PLATFORMS = [
+  { id: "youtube", label: "YouTube", collector: true, cumulativeViews: "youtube_channel_view_count" },
+  { id: "tiktok", label: "TikTok", collector: true, cumulativeViews: "tiktok_listed_video_view_sum" },
+  { id: "instagram", label: "Instagram", collector: true, cumulativeViews: null },
+  { id: "threads", label: "Threads", collector: true, cumulativeViews: null },
+  { id: "facebook", label: "Facebook", collector: false, cumulativeViews: null },
+  { id: "x", label: "X", collector: false, cumulativeViews: null },
+  { id: "blogger", label: "Blogger", collector: false, cumulativeViews: null },
+  { id: "naver-blog", label: "네이버 블로그", collector: false, cumulativeViews: null },
+  { id: "naver-clip", label: "네이버 클립", collector: false, cumulativeViews: null },
+  { id: "youtube-community", label: "유튜브 커뮤니티", collector: false, cumulativeViews: null },
+];
+
+const METRICS = {
+  youtube: [
+    { key: "views", label: "누적 조회수", unit: "회", kind: "cumulative", definition: "채널에 쌓인 조회수입니다. 그 주에 새로 생긴 조회수만 뜻하지는 않습니다.", comparable: "youtube_channel_view_count" },
+    { key: "followers", label: "구독자", unit: "명", kind: "cumulative", definition: "기준 시각의 구독자 수입니다.", comparable: null },
+    { key: "videos", label: "동영상 수", unit: "개", kind: "cumulative", definition: "기준 시각의 동영상 수입니다.", comparable: null },
+  ],
+  tiktok: [
+    { key: "views", label: "영상 조회수 합", unit: "회", kind: "cumulative", definition: "수집 당시 영상들의 조회수를 더한 값입니다. 유튜브 누적 조회수와는 다릅니다.", comparable: "tiktok_listed_video_view_sum" },
+    { key: "followers", label: "팔로워", unit: "명", kind: "cumulative", definition: "기준 시각의 팔로워 수입니다.", comparable: null },
+    { key: "likes", label: "좋아요", unit: "개", kind: "cumulative", definition: "기준 시각까지 받은 좋아요 수입니다.", comparable: null },
+    { key: "videos", label: "동영상 수", unit: "개", kind: "cumulative", definition: "기준 시각의 동영상 수입니다.", comparable: null },
+  ],
+  instagram: [
+    { key: "dayViews", label: "하루 조회", unit: "회", kind: "period_occurring", definition: "그 날짜에 기록이 있을 때만 하루 동안의 조회입니다.", comparable: null },
+    { key: "followers", label: "팔로워", unit: "명", kind: "cumulative", definition: "기준 시각의 팔로워 수입니다.", comparable: null },
+    { key: "videos", label: "게시물 수", unit: "개", kind: "cumulative", definition: "기준 시각의 게시물 수입니다.", comparable: null },
+  ],
+  threads: [
+    { key: "dayViews", label: "하루 조회", unit: "회", kind: "period_occurring", definition: "그 날짜에 기록이 있을 때만 하루 동안의 조회입니다.", comparable: null },
+    { key: "followers", label: "팔로워", unit: "명", kind: "cumulative", definition: "기준 시각의 팔로워 수입니다.", comparable: null },
+  ],
+};
+
+function addDays(dateStr, n) {
+  return new Date(Date.parse(dateStr + "T00:00:00Z") + n * DAY).toISOString().slice(0, 10);
+}
+
+function kstDate(ms = Date.now()) {
+  return new Date(ms + 9 * 3600 * 1000).toISOString().slice(0, 10);
+}
+
+function isDate(value) {
+  return typeof value === "string" && /^\d{4}-\d{2}-\d{2}$/.test(value) && !Number.isNaN(Date.parse(value + "T00:00:00Z"));
+}
+
+function enumerate(start, end) {
+  const out = [];
+  for (let d = start; d <= end; d = addDays(d, 1)) out.push(d);
+  return out;
+}
+
+function finiteNumber(value) {
+  return typeof value === "number" && Number.isFinite(value) ? value : null;
+}
+
+function formatKst(iso) {
+  const ms = Date.parse(iso || "");
+  if (!Number.isFinite(ms)) return null;
+  const d = new Date(ms + 9 * 3600 * 1000);
+  const p = (n) => String(n).padStart(2, "0");
+  return `${d.getUTCFullYear()}-${p(d.getUTCMonth() + 1)}-${p(d.getUTCDate())} ${p(d.getUTCHours())}:${p(d.getUTCMinutes())} 한국시간`;
+}
+
+function stateLabel(code) {
+  return STATE_LABELS[code] || "알 수 없음";
+}
+
+function readSnapshotFile(filePath = SNAP_PATH) {
+  try {
+    const data = JSON.parse(fs.readFileSync(filePath, "utf8"));
+    if (!data || typeof data !== "object" || !data.days || typeof data.days !== "object") {
+      return { version: 1, days: {}, lastRunAt: null };
+    }
+    return data;
+  } catch {
+    return { version: 1, days: {}, lastRunAt: null };
+  }
+}
+
+function resolveWindow({ end, days, now }) {
+  const length = WINDOW_DAYS.has(Number(days)) ? Number(days) : 7;
+  const endDate = isDate(end) ? end : kstDate(now ? Date.parse(now) : Date.now());
+  const start = addDays(endDate, -(length - 1));
+  const dates = enumerate(start, endDate);
+  const priorEnd = addDays(start, -1);
+  const priorStart = addDays(priorEnd, -(length - 1));
+  return { days: length, start, end: endDate, dates, priorStart, priorEnd, priorDates: enumerate(priorStart, priorEnd), timeZone: "Asia/Seoul" };
+}
+
+function snapKey(email, clientId, platform) {
+  return `${String(email || "").toLowerCase()}|${clientId}|${platform}`;
+}
+
+function rowFor(snapshots, email, clientId, platform, date) {
+  const day = snapshots && snapshots.days && snapshots.days[date];
+  if (!day) return null;
+  const row = day[snapKey(email, clientId, platform)];
+  if (!row) return null;
+  if (row.email && row.email !== String(email).toLowerCase()) return null;
+  if (row.clientId && row.clientId !== clientId) return null;
+  return row;
+}
+
+function ambiguousYoutubeZero(metricKey, row, value) {
+  if (value !== 0) return false;
+  if (metricKey !== "views" && metricKey !== "followers" && metricKey !== "videos") return false;
+  const at = Date.parse(row && row.at);
+  if (!Number.isFinite(at)) return true;
+  return at <= YT_ZERO_COERCION_UNTIL_MS;
+}
+
+function pointState(platformId, metric, row) {
+  if (!row || row.error) return { state: "absent", value: null };
+  if (!Object.prototype.hasOwnProperty.call(row, metric.key) || row[metric.key] == null) {
+    const missing = new Set(row.missingScope || []);
+    if (missing.size) return { state: "permission_needed", value: null, reason: Array.from(missing).join(", ") };
+    if (Object.prototype.hasOwnProperty.call(row, metric.key)) return { state: "unavailable", value: null };
+    return { state: "absent", value: null };
+  }
+  const value = finiteNumber(row[metric.key]);
+  if (value == null) return { state: "unknown", value: null, reason: "숫자 값이 아닙니다" };
+  if (platformId === "youtube" && ambiguousYoutubeZero(metric.key, row, value)) {
+    return {
+      state: "ambiguous_zero",
+      value: 0,
+      reason: "0으로 저장되어 있습니다. 2026-11-06 13:27 한국시간까지 수집기는 빠진 YouTube 통계를 0으로 넣었습니다. 이 수집 시각은 그 경계 이전이라 실제 0으로 단정하지 않습니다.",
+    };
+  }
+  if (value === 0) return { state: "actual_zero", value: 0 };
+  return { state: "available", value };
+}
+
+function seriesFor(snapshots, email, clientId, platform, metric, dates) {
+  const points = [];
+  const cells = [];
+  for (const date of dates) {
+    const row = rowFor(snapshots, email, clientId, platform.id, date);
+    if (!row) {
+      cells.push({ date, state: "absent", stateLabel: stateLabel("absent"), value: null });
+      continue;
+    }
+    if (row.error && finiteNumber(row[metric.key]) == null) {
+      cells.push({
+        date,
+        state: "collection_error",
+        stateLabel: stateLabel("collection_error"),
+        value: null,
+        reason: String(row.error),
+      });
+      continue;
+    }
+    const point = pointState(platform.id, metric, row);
+    cells.push({
+      date,
+      ...point,
+      stateLabel: stateLabel(point.state),
+      at: row.at || null,
+      atKst: formatKst(row.at),
+    });
+    if (point.state === "available" || point.state === "actual_zero") {
+      const prev = points[points.length - 1];
+      points.push({ date, value: point.value, gapBefore: prev ? addDays(prev.date, 1) !== date : false });
+    }
+  }
+  return { points, cells };
+}
+
+function observedSpan(points) {
+  if (points.length < 2) {
+    return { eligible: false, reason: "숫자 수집점이 2개 미만입니다." };
+  }
+  const first = points[0];
+  const last = points[points.length - 1];
+  const spanDays = enumerate(first.date, last.date).length - 1;
+  return {
+    eligible: true,
+    fromDate: first.date,
+    toDate: last.date,
+    fromValue: first.value,
+    toValue: last.value,
+    difference: last.value - first.value,
+    spanDays,
+    label: `${first.date} ${first.value} -> ${last.date} ${last.value}`,
+  };
+}
+
+function boundaryDelta(points, start, end) {
+  const a = points.find((point) => point.date === start);
+  const b = points.find((point) => point.date === end);
+  if (!a || !b) {
+    return { eligible: false, reason: "기간의 시작일 또는 종료일에 숫자 수집점이 없습니다. 없는 날을 0으로 두지 않습니다." };
+  }
+  return {
+    eligible: true,
+    fromDate: start,
+    toDate: end,
+    fromValue: a.value,
+    toValue: b.value,
+    difference: b.value - a.value,
+    label: `${start} ${a.value} -> ${end} ${b.value}`,
+  };
+}
+
+function comparisonText(prior, current) {
+  if (!prior || !prior.eligible || !current || !current.eligible) {
+    return { eligible: false, text: "같은 정의의 이전 기간 비교는 없습니다.", prior: null, current: current && current.eligible ? current : null };
+  }
+  if (prior.difference === 0) {
+    return { eligible: true, text: `0 -> ${current.difference}`, prior, current, percent: null };
+  }
+  return {
+    eligible: true,
+    text: `${prior.difference} -> ${current.difference}`,
+    prior,
+    current,
+    percent: null,
+  };
+}
+
+function periodOccurring(cells, dates) {
+  const observed = cells.filter((cell) => cell.state === "available" || cell.state === "actual_zero");
+  if (!observed.length) return { eligible: false, reason: "기간 안에 하루 조회 숫자가 없습니다.", observedDays: 0, windowDays: dates.length };
+  const sum = observed.reduce((total, cell) => total + cell.value, 0);
+  return {
+    eligible: true,
+    complete: observed.length === dates.length,
+    sum,
+    observedDays: observed.length,
+    windowDays: dates.length,
+    missingDays: dates.length - observed.length,
+    label: observed.length === dates.length
+      ? `기간 발생 조회 합 ${sum}`
+      : `관측 ${observed.length}일 합 ${sum}. 빠진 ${dates.length - observed.length}일은 합계에 넣지 않았습니다.`,
+  };
+}
+
+function latestCollectedAt(snapshots, email, clientId) {
+  let latest = null;
+  const days = (snapshots && snapshots.days) || {};
+  for (const date of Object.keys(days)) {
+    for (const platform of PLATFORMS) {
+      const row = rowFor(snapshots, email, clientId, platform.id, date);
+      if (!row || !row.at) continue;
+      if (!latest || row.at > latest) latest = row.at;
+    }
+  }
+  return latest || (snapshots && snapshots.lastRunAt) || null;
+}
+
+function accountOf(conn) {
+  if (!conn || !conn.account) return null;
+  return { displayName: conn.account.displayName || null, id: conn.account.id || null };
+}
+
+function channelStatus(platform, conn) {
+  if (!platform.collector) return { code: "unsupported", label: "조회 스냅샷 대상 아님" };
+  if (!conn || (!conn.hasToken && !(conn.account && (conn.account.displayName || conn.account.id)))) {
+    return { code: "unconnected", label: "연결 안 됨" };
+  }
+  if (conn.hasToken && conn.account) return { code: "connected", label: "연결됨" };
+  if (!conn.hasToken) return { code: "unconnected", label: "연결 안 됨" };
+  return { code: "unknown", label: "계정 식별자 없음" };
+}
+
+function metricReport(platform, metric, snapshots, email, clientId, window) {
+  const currentSeries = seriesFor(snapshots, email, clientId, platform, metric, window.dates);
+  const priorSeries = seriesFor(snapshots, email, clientId, platform, metric, window.priorDates);
+  const span = observedSpan(currentSeries.points);
+  const boundary = boundaryDelta(currentSeries.points, window.start, window.end);
+  const priorBoundary = boundaryDelta(priorSeries.points, window.priorStart, window.priorEnd);
