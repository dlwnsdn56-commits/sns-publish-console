+const fs = require("fs");
+const path = require("path");
+const test = require("node:test");
+const assert = require("node:assert/strict");
+
+const terms = fs.readFileSync(path.join(__dirname, "..", "public", "terms.html"), "utf8");
+const refund = fs.readFileSync(path.join(__dirname, "..", "public", "refund.html"), "utf8");
+
+test("agency draft accepts cancellation anytime and leaves undecided numbers as choices", () => {
+  for (const text of [terms, refund]) {
+    assert.equal(text.includes("법률 자문이 아닙니다"), true);
+    assert.equal(text.includes("월 88만원"), true);
+    assert.equal(text.includes("7일 동안 다시 시도"), true);
+    assert.equal(text.includes("다음 달까지만 이월"), true);
+    assert.equal(text.includes("해지 신청은 언제든 가능"), true);
+    assert.equal(text.includes("3개월 전에는 해지 신청을 받지 않습니다"), false);
+    assert.equal(text.includes("한 편도 만들지 않은 경우"), true);
+    assert.equal(text.includes("【선택:"), true);
+    assert.equal(text.includes("전자상거래법"), true);
+  }
+  assert.equal(terms.includes("출시 요금은 월 9,900원입니다."), true);
+  assert.equal(refund.includes("출시 요금 월 9,900원"), true);
+});
