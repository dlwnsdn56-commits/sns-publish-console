diff -u -r -N a/test/agency-terms.test.js b/test/agency-terms.test.js
--- a/test/agency-terms.test.js	1970-01-01 00:00:00.000000000 +0000
+++ b/test/agency-terms.test.js	2026-11-10 08:28:59.350826433 +0000
@@ -0,0 +1,31 @@
+const fs = require("fs");
+const path = require("path");
+const test = require("node:test");
+const assert = require("node:assert/strict");
+
+const terms = fs.readFileSync(path.join(__dirname, "..", "public", "terms.html"), "utf8");
+const refund = fs.readFileSync(path.join(__dirname, "..", "public", "refund.html"), "utf8");
+
+test("finished agency draft delivers unstarted videos until cancellation and keeps files for six months", () => {
+  for (const text of [terms, refund]) {
+    assert.equal(text.includes("법률 자문이 아닙니다"), true);
+    assert.equal(text.includes("월 88만원"), true);
+    assert.equal(text.includes("고객의 자료를 받아 편집을 시작한 때"), true);
+    assert.equal(text.includes("아직 시작하지 않은 영상은 환불하지 않고, 해지가 효력을 내는 날까지 제작해 납품합니다"), true);
+    assert.equal(text.includes("그 외에는 환불하지 않습니다"), true);
+    assert.equal(text.includes("〔충돌 확인 필요〕"), false);
+    assert.equal(text.includes("정산 방법과 금액"), false);
+    assert.equal(text.includes("다음 자동결제일 전"), true);
+    assert.equal(text.includes("편당 1회"), true);
+    assert.equal(text.includes("계약은 끝나고, 이미 만든 영상만 인도합니다"), true);
+    assert.equal(text.includes("이용 기간을 늘립니다"), true);
+    assert.equal(text.includes("저작권은 회사에 있습니다"), true);
+    assert.equal(text.includes("납품 후 6개월"), true);
+    assert.equal(text.includes("【보관 기간: 미정】"), false);
+    assert.equal(text.includes("법령과 카드사"), true);
+    assert.equal(text.includes("【선택"), false);
+    assert.equal(text.includes("3개월 전에는 해지 신청을 받지 않습니다"), false);
+  }
+  assert.equal(terms.includes("출시 요금은 월 9,900원입니다."), true);
+  assert.equal(refund.includes("출시 요금 월 9,900원"), true);
+});
