+    getChannel: (id) => ({ id, name: id, kind: "api" }),
+    isRpaKind: () => false,
+    resolvePlan: () => ({ isPaid: true, usedThisMonth: 0, freeLimit: 10, planId: "starter" }),
+    store: {
+      parseSeoulLocalDateTime: () => null,
+      isScheduleTooFar: () => false,
+      isFutureSeoulLocal: () => false,
+      addJob: (job, tasks) => saved.push({ job, tasks }),
+      RPA_STATUS_QUEUED: "대기",
+    },
+  });
+  assert.equal(outcome.ok, true);
+  assert.equal(outcome.job.captionX, "");
+  assert.equal(outcome.job.captionThreads, "스레드 글");
+  const byChannel = Object.fromEntries(outcome.tasks.map((task) => [task.channel, task.caption]));
+  assert.equal(byChannel.youtube, "기본 설명");
+  assert.equal(byChannel.x, "기본 설명");
+  assert.equal(byChannel.threads, "스레드 글");
+  assert.equal(mergeCaptionFields({ caption_x: "유지" }).captionX, "유지");
+  assert.equal(saved.length, 0);
+});
