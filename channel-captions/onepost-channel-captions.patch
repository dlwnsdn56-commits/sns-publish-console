diff -u -r -N a/lib/channel-caption.js b/lib/channel-caption.js
--- a/lib/channel-caption.js	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/channel-caption.js	2026-11-12 14:11:51.573101049 +0000
@@ -0,0 +1,133 @@
+const X_LIMIT = 280;
+const THREADS_LIMIT = 500;
+const URL_WEIGHT = 23;
+const URL_RE = /https?:\/\/\S+/gi;
+
+function graphemes(text) {
+  const source = String(text == null ? "" : text);
+  try {
+    if (typeof Intl !== "undefined" && typeof Intl.Segmenter === "function") {
+      return Array.from(new Intl.Segmenter("ko", { granularity: "grapheme" }).segment(source), (part) => part.segment);
+    }
+  } catch (_err) {
+    /* fall through */
+  }
+  return Array.from(source);
+}
+
+function isCjk(char) {
+  const code = char.codePointAt(0);
+  return (
+    (code >= 0x1100 && code <= 0x11ff) ||
+    (code >= 0x3130 && code <= 0x318f) ||
+    (code >= 0xac00 && code <= 0xd7a3) ||
+    (code >= 0x3040 && code <= 0x30ff) ||
+    (code >= 0x3400 && code <= 0x9fff) ||
+    (code >= 0xf900 && code <= 0xfaff) ||
+    (code >= 0xff00 && code <= 0xffef)
+  );
+}
+
+function xWeight(text) {
+  const source = String(text == null ? "" : text);
+  let weight = 0;
+  let last = 0;
+  source.replace(URL_RE, (url, index) => {
+    weight += weightPlain(source.slice(last, index));
+    weight += URL_WEIGHT;
+    last = index + url.length;
+    return url;
+  });
+  weight += weightPlain(source.slice(last));
+  return weight;
+}
+
+function weightPlain(text) {
+  let weight = 0;
+  Array.from(text).forEach((char) => {
+    weight += isCjk(char) ? 2 : 1;
+  });
+  return weight;
+}
+
+function threadsLength(text) {
+  return graphemes(text).length;
+}
+
+function meaningful(value) {
+  const text = String(value == null ? "" : value);
+  return text.trim() ? text : "";
+}
+
+function mergeCaptionFields(input) {
+  const source = input || {};
+  const map = Object.assign({}, source.captionsByChannel || {});
+  function take(key, values) {
+    for (const value of values) {
+      if (value !== undefined && value !== null) {
+        map[key] = String(value).slice(0, 8000);
+        return;
+      }
+    }
+  }
+  take("x", [source.caption_x, source.captionX]);
+  take("threads", [source.caption_threads, source.captionThreads]);
+  return {
+    captionsByChannel: map,
+    captionX: meaningful(map.x),
+    captionThreads: meaningful(map.threads),
+  };
+}
+
+function channelId(id) {
+  const text = String(id || "");
+  if (text === "twitter") return "x";
+  return text;
+}
+
+function captionForChannel(job, id) {
+  const source = job || {};
+  const base = String(source.caption || "");
+  const key = channelId(id);
+  const merged = mergeCaptionFields(source);
+  if (key === "x") return merged.captionX || base;
+  if (key === "threads") return merged.captionThreads || base;
+  return base;
+}
+
+function captionJobForChannel(job, id) {
+  return Object.assign({}, job || {}, { caption: captionForChannel(job, id) });
+}
+
+function captionWarnings(input) {
+  const source = input || {};
+  const base = String(source.caption || "");
+  const xOwn = meaningful(source.captionX != null ? source.captionX : source.x);
+  const threadsOwn = meaningful(source.captionThreads != null ? source.captionThreads : source.threads);
+  const warnings = [];
+  const xText = xOwn || base;
+  const threadsText = threadsOwn || base;
+  if (xWeight(xText) > X_LIMIT) {
+    warnings.push(xOwn
+      ? "트위터 설명글이 280을 넘었습니다. (" + xWeight(xText) + "/280)"
+      : "기본 설명글이 트위터 한도보다 깁니다. 트위터 칸을 따로 적어 주세요. (" + xWeight(xText) + "/280)");
+  }
+  if (threadsLength(threadsText) > THREADS_LIMIT) {
+    warnings.push(threadsOwn
+      ? "스레드 설명글이 500자를 넘었습니다. (" + threadsLength(threadsText) + "/500)"
+      : "기본 설명글이 스레드 한도보다 깁니다. 스레드 칸을 따로 적어 주세요. (" + threadsLength(threadsText) + "/500)");
+  }
+  return warnings;
+}
+
+module.exports = {
+  X_LIMIT,
+  THREADS_LIMIT,
+  URL_WEIGHT,
+  xWeight,
+  threadsLength,
+  mergeCaptionFields,
+  captionForChannel,
+  captionJobForChannel,
+  captionWarnings,
+};
