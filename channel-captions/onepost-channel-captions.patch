--- a/test/channel-caption.test.js	1970-01-01 00:00:00.000000000 +0000
+++ b/test/channel-caption.test.js	2026-11-12 14:11:51.573101049 +0000
@@ -0,0 +1,65 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const { xWeight, threadsLength, captionForChannel, mergeCaptionFields, captionWarnings } = require("../lib/channel-caption");
+const { createPublishJob } = require("../lib/publish-job");
+
+test("x weight counts Korean as 2 and a url as 23", () => {
+  assert.equal(xWeight("abc"), 3);
+  assert.equal(xWeight("가"), 2);
+  assert.equal(xWeight("가a"), 3);
+  assert.equal(xWeight("https://example.com/very/long/path"), 23);
+  assert.equal(xWeight("안녕 https://x.test/a"), 28);
+  assert.equal(threadsLength("가나다"), 3);
+  assert.equal(threadsLength("a".repeat(500)), 500);
+});
+
+test("empty channel caption falls back to the default", () => {
+  const job = { caption: "기본글", captionsByChannel: { x: "", threads: "스레드만" } };
+  assert.equal(captionForChannel(job, "instagram"), "기본글");
+  assert.equal(captionForChannel(job, "x"), "기본글");
+  assert.equal(captionForChannel(job, "twitter"), "기본글");
+  assert.equal(captionForChannel(job, "threads"), "스레드만");
+  assert.equal(captionForChannel({ caption: "기본", caption_x: "엑스" }, "youtube"), "기본");
+  assert.equal(captionForChannel({ caption: "기본", caption_x: "엑스" }, "x"), "엑스");
+  const warns = captionWarnings({ caption: "가".repeat(200) });
+  assert.equal(warns.some((line) => line.includes("트위터 칸을 따로")), true);
+  assert.equal(captionWarnings({ caption: "짧은 글" }).length, 0);
+});
+
+test("publish stores the channel caption and keeps an empty override", () => {
+  const saved = [];
+  const outcome = createPublishJob({
+    email: "owner@example.test",
+    body: {
+      clientId: "shop",
+      mediaType: "video",
+      channels: ["youtube", "x", "threads"],
+      caption: "기본 설명",
+      caption_x: "",
+      caption_threads: "스레드 글",
+    },
+    files: [{ originalName: "a.mp4", storedName: "a.mp4", mimeType: "video/mp4", size: 10 }],
+    dryRun: true,
