+const test = require("node:test");
+const assert = require("node:assert/strict");
+const { buildReport } = require("../public/yt-report");
+
+function metric(key, label, value) {
+  return { key, label, value, state: "available", previousValue: null };
+}
+
+test("store report lists seven channels and does not invent missing numbers", () => {
+  const report = buildReport({
+    mode: "store",
+    brandName: "테스트 가게",
+    now: new Date("2026-11-12T03:00:00.000Z"),
+    analysisChannels: [
+      {
+        channelId: "youtube",
+        label: "유튜브",
+        account: { displayName: "kitchen" },
+        connection: { code: "connected" },
+        metrics: [metric("subscribers", "구독자", 1500), metric("views", "조회수", 120000), metric("videoCount", "영상 수", 34)],
+      },
+      {
+        channelId: "instagram",
+        label: "인스타그램",
+        connection: { code: "connected" },
+        metrics: [metric("followers", "팔로워", 340)],
+      },
+    ],
+  });
+  assert.equal(report.channels.length, 7);
+  assert.equal(report.channels.some((item) => item.id === "blogger" || item.name.includes("블로그")), false);
+  const facebook = report.channels.find((item) => item.id === "facebook");
+  assert.equal(facebook.state, "disconnected");
+  assert.equal(facebook.stats.length, 0);
+  assert.equal(report.totals.followers, 1500 + 340);
+  assert.equal(report.totals.views, 120000);
+  assert.equal(report.totals.best, "유튜브");
+  assert.equal(JSON.stringify(facebook).includes("999"), false);
+});
+
+test("manual input fills only that channel", () => {
+  const report = buildReport({
+    youtube: { title: "테스트키친", handle: "testkitchen", subscribers: 10, videoCount: 2, views: 30, recentVideos: [] },
+    manual: { tiktok: { followers: 8, posts: 3, handle: "clip" } },
+    now: new Date("2026-11-12T00:00:00.000Z"),
+  });
+  const tiktok = report.channels.find((item) => item.id === "tiktok");
+  const threads = report.channels.find((item) => item.id === "threads");
+  assert.equal(tiktok.state, "ok");
+  assert.equal(tiktok.stats.find((item) => item.id === "followers").value, 8);
+  assert.equal(threads.state, "disconnected");
+  assert.equal(threads.stats.length, 0);
+  assert.equal(report.channels.find((item) => item.id === "youtube").stats.find((item) => item.id === "followers").value, 10);
+});
+
+test("mock flag is off unless the caller marks the sample", () => {
+  const live = buildReport({ brandName: "가게", now: new Date("2026-11-12T00:00:00.000Z") });
+  assert.equal(live.mock, false);
+  const sample = buildReport({ brandName: "가게", mock: true, now: new Date("2026-11-12T00:00:00.000Z") });
+  assert.equal(sample.mock, true);
+  assert.equal(live.channels.filter((item) => item.state === "ok").length, 0);
+});
