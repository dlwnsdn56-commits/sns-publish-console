--- a/test/ether-dalgomaebgo.test.js
+++ b/test/ether-dalgomaebgo.test.js
@@ -0,0 +1,33 @@
+const fs = require("fs");
+const path = require("path");
+const test = require("node:test");
+const assert = require("node:assert/strict");
+
+const htmlPath = process.env.ETHER_HTML || path.join(__dirname, "..", "public", "ether.html");
+const html = fs.readFileSync(htmlPath, "utf8");
+
+const ids = ["H9L55vqPBg4", "v-Lhi4D9DBM", "E2KsdVWaZOA", "qo8KOEd-0W4", "DkhVDGMPr00", "Q2cB91Bh3RQ"];
+
+test("ether homepage keeps Sua and existing work, and adds Dalgo Maebgo as a managed channel", () => {
+  assert.equal(html.includes("WORK 01"), true);
+  assert.equal(html.includes("WORK 02"), true);
+  assert.equal(html.includes("WORK 03"), true);
+  assert.equal(html.includes("nbsmZ-613h4"), true);
+  assert.equal(html.includes("/ether/sua#sponsor"), true);
+  assert.equal(html.includes("달고맵고 · 고객 채널 운영 사례"), true);
+  assert.equal(html.includes("에테르가 운영을 맡은 달고맵고의 유튜브 채널입니다. 제품과 브랜드를 소개하는 영상을 만나보세요."), true);
+  assert.equal(html.includes("https://www.youtube.com/channel/UCbuhFCo4kRgg3k1hZA0zkZA"), true);
+  assert.equal(html.includes('src="/logo-aether-mark.png"'), true);
+  const section = html.slice(html.indexOf('id="dalgomaebgo"'), html.indexOf('id="service"'));
+  for (const hidden of ["모든 영상을 만들었다고", "삽입이 막히면", "썸네일은", "채널 이름", "조회수", "성과"]) {
+    assert.equal(section.includes(hidden), false, hidden);
+  }
+  for (const id of ids) {
+    assert.equal(html.includes(`data-yt="${id}"`), true);
+    assert.equal(html.includes(`https://i.ytimg.com/vi/${id}/hqdefault.jpg`), true);
+    assert.equal(html.includes(`src="https://www.youtube-nocookie.com/embed/${id}`), false);
+  }
+  assert.equal(html.includes("https://www.youtube.com/watch?v=H9L55vqPBg4"), true);
+  assert.equal(html.includes("https://www.youtube.com/shorts/E2KsdVWaZOA"), true);
+  assert.equal((html.match(/<iframe/g) || []).length, 0);
+});
