diff -u -r -N a/test/analysis-report-only.test.js b/test/analysis-report-only.test.js
--- a/test/analysis-report-only.test.js	1970-01-01 00:00:00.000000000 +0000
+++ b/test/analysis-report-only.test.js	2026-11-12 11:06:07.382344517 +0000
@@ -0,0 +1,31 @@
+const fs = require("fs");
+const path = require("path");
+const test = require("node:test");
+const assert = require("node:assert/strict");
+
+const index = fs.readFileSync(path.join(__dirname, "..", "public", "index.html"), "utf8");
+const app = fs.readFileSync(path.join(__dirname, "..", "public", "app.js"), "utf8");
+
+function section(id) {
+  const start = index.indexOf('id="' + id + '"');
+  const end = index.indexOf("<section", start + 10);
+  return index.slice(start, end === -1 ? start + 4000 : end);
+}
+
+test("channel analysis tab shows only the one-page report", () => {
+  const analysis = section("view-analysis");
+  assert.equal(analysis.includes('id="analysis-report-sheet"'), true);
+  assert.equal(analysis.includes("PNG 저장"), true);
+  assert.equal(analysis.includes("PDF 저장"), true);
+  assert.equal(analysis.includes("<summary>숫자 직접 입력</summary>"), true);
+  assert.equal(/<details id="analysis-manual" open/.test(analysis), false);
+  assert.equal(analysis.includes('id="analysis-body" hidden'), true);
+  assert.equal(analysis.includes("analysis-table"), false);
+  assert.equal(analysis.includes("한 장 보고서</button>"), false);
+  const insights = section("view-insights");
+  assert.equal(insights.includes("일간"), true);
+  assert.equal(insights.includes("지금 불러오기"), true);
+  const research = section("view-yt-research");
+  assert.equal(research.includes("단어로 영상 찾기"), true);
+  assert.equal(app.includes("renderChannelAnalysisView"), true);
+});
