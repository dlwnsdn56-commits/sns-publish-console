+      <div class="client-row" style="margin-top:14px"><b>Claude 맞춤 커넥터</b><span class="wait-note">헤더가 보일 때만</span></div>
+      <p>Claude 공식 안내에는 요청 헤더로 고정 키를 넣는 방법이 있습니다. 커넥터를 추가하는 화면에 요청 헤더 칸이 보이면, 헤더 이름 <code>Authorization</code> 과 값 <code>Bearer opm_...</code> 를 넣으면 됩니다. 로그인이나 OAuth만 보이는 화면은 원포스트와 아직 연결되지 않습니다. 그 방식은 준비 중입니다. Claude에서 실제 연결과 조회는 확인하지 않았습니다.</p>
+    </section>
+  </main>
+</div>
+</body>
+</html>
--- a/test/mcp-guide.test.js
+++ b/test/mcp-guide.test.js
@@ -0,0 +1,40 @@
+const fs = require("fs");
+const path = require("path");
+const test = require("node:test");
+const assert = require("node:assert/strict");
+
+const root = path.join(__dirname, "..");
+const guide = fs.readFileSync(path.join(root, "public", "mcp-guide.html"), "utf8");
+const index = fs.readFileSync(path.join(root, "public", "index.html"), "utf8");
+const mcp = fs.readFileSync(path.join(root, "lib", "mcp.js"), "utf8");
+const keys = fs.readFileSync(path.join(root, "public", "mcp-keys.html"), "utf8");
+
+test("AI guide explains the real connection and does not add unverified claims", () => {
+  assert.equal(guide.includes("https://1post.kr/mcp"), true);
+  assert.equal(guide.includes('href="/mcp/keys"'), true);
+  assert.equal(guide.includes("opm_..."), true);
+  assert.equal(guide.includes("만드는 순간에만"), true);
+  assert.equal(guide.includes("필요한 것만"), true);
+  assert.equal(guide.includes("승인 화면에서 확인한 뒤에만"), true);
+  assert.equal(guide.includes("2026-11-07"), true);
+  assert.equal(guide.includes("Authorization"), true);
+  assert.equal(guide.includes("준비 중"), true);
+  assert.equal(guide.includes("확인하지 않았습니다"), true);
+  for (const banned of ["공식 등재", "절감", "경쟁사", "%", "1위", "모든 AI"]) {
+    assert.equal(guide.includes(banned), false, banned);
+  }
+  assert.equal(guide.includes("opm_live"), false);
+  assert.equal(guide.includes("sk-"), false);
+});
+
+test("logged-in navigation points at the guide, and the server route only serves the page", () => {
+  assert.equal(index.includes('href="/mcp/guide">AI 연결</a>'), true);
+  assert.equal(index.includes('href="/mcp/keys"'), false);
+  assert.equal(index.includes('href="/mcp/guide">AI 연결 안내</a>'), true);
+  assert.equal(mcp.includes('app.get("/mcp/guide"'), true);
+  assert.equal(mcp.includes('public", "mcp-guide.html"'), true);
+  assert.equal(keys.includes('href="/mcp/guide"'), true);
+  const route = mcp.slice(mcp.indexOf('app.get("/mcp/guide"'), mcp.indexOf('app.get("/mcp/keys"'));
+  assert.equal(route.includes("createPublishJob"), false);
+  assert.equal(route.includes("runPublish"), false);
+});
