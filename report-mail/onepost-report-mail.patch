+
+function ymdOf(date) {
+  const parts = kstParts(date);
+  return parts.year + "-" + String(parts.month).padStart(2, "0") + "-" + String(parts.day).padStart(2, "0");
+}
+
+function addDays(ymd, days) {
+  const [year, month, day] = ymd.split("-").map(Number);
+  const next = new Date(Date.UTC(year, month - 1, day + days));
+  return next.toISOString().slice(0, 10);
+}
+
+function daySpan(later, earlier) {
+  const end = Date.parse(later + "T00:00:00Z");
+  const start = Date.parse(earlier + "T00:00:00Z");
+  return Math.round((end - start) / 86400000);
+}
+
+function finiteOrNull(value) {
+  const number = Number(value);
+  return Number.isFinite(number) ? number : null;
+}
+
+function datesAfterThrough(after, until) {
+  const out = [];
+  let cursor = addDays(after, 1);
+  while (cursor <= until) {
+    out.push(cursor);
+    cursor = addDays(cursor, 1);
+  }
+  return out;
+}
+
+function latestAtOrBefore(points, ymd, key) {
+  let found = null;
+  points.forEach((point) => {
+    if (point.date <= ymd && Number.isFinite(point[key])) found = point;
+  });
+  return found;
+}
+
+function deltaCumulative(points, key, from, to) {
+  const newer = latestAtOrBefore(points, to, key);
+  const older = latestAtOrBefore(points, from, key);
+  if (!newer || !older || newer.date <= from) return null;
+  if (daySpan(newer.date, older.date) > 8) return null;
+  return newer[key] - older[key];
+}
+
+function sumDaily(points, key, from, to) {
+  const byDate = {};
+  points.forEach((point) => {
+    if (Number.isFinite(point[key])) byDate[point.date] = point[key];
+  });
+  const days = datesAfterThrough(from, to);
+  if (!days.length || days.some((date) => !Number.isFinite(byDate[date]))) return null;
+  return days.reduce((sum, date) => sum + byDate[date], 0);
+}
+
+function changePercent(current, previous) {
+  if (!Number.isFinite(current) || !Number.isFinite(previous) || previous === 0) return null;
+  return Math.round(((current - previous) / Math.abs(previous)) * 100);
+}
+
+function normalizePoints(points) {
+  return (points || []).map((point) => ({
