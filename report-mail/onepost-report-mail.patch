+        const owner = mail.ownerEmail(clientId) || (source.ownerEmail ? source.ownerEmail(clientId) : "");
+        return {
+          report: source.loadReport ? await source.loadReport(owner, clientId) : null,
+          weekly: asWeekly(source.loadWeekly ? await source.loadWeekly(owner, clientId) : null) || buildWeekly({ now: new Date(), email: owner, clientId }),
+          clientName: source.clientName ? source.clientName(owner, clientId) : "",
+        };
+      }).catch(() => {});
+    }, 60 * 1000);
+    if (timer.unref) timer.unref();
+  }
+  return { enabled: true, mail };
+}
+
+module.exports = {
+  mailEnabled,
+  validEmail,
+  fillTemplate,
+  buildWeekly,
+  renderViewPage,
+  nextRun,
+  slotKey,
+  normalizeSettings,
+  renderEmail,
+  createReportMail,
+  createSmtpTransport,
+  mountReportMail,
+  WEEKDAYS,
+};
