+      dayViews: row.dayViews,
+      followers: row.followers,
+      posts: row.videos != null ? row.videos : row.posts,
+    };
+  }).filter(Boolean));
+}
+
+function channelConnected(connections, id) {
+  const row = connections && connections[id];
