+  { id: "threads", name: "스레드", color: "#111111", followerLabel: "팔로워", dailyViews: true },
+  { id: "tiktok", name: "틱톡", color: "#111111", followerLabel: "팔로워" },
+  { id: "x", name: "X", color: "#111111", followerLabel: "팔로워" },
