+  return !!(row.connected || row.hasToken || row.account);
+}
+
+function metricPair(points, key, mode, start, mid, end) {
+  const current = mode === "daily" ? sumDaily(points, key, mid, end) : deltaCumulative(points, key, mid, end);
+  const previous = mode === "daily" ? sumDaily(points, key, start, mid) : deltaCumulative(points, key, start, mid);
+  return { current, previous, change: changePercent(current, previous) };
+}
