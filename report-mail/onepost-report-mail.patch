+    followers: finiteOrNull(point.followers),
+    posts: finiteOrNull(point.posts != null ? point.posts : point.videos),
+  })).filter((point) => /^\d{4}-\d{2}-\d{2}$/.test(point.date)).sort((a, b) => a.date.localeCompare(b.date));
+}
+
+function pointsFromSnapshots(snapshots, email, clientId, platform) {
+  const key = String(email || "").toLowerCase() + "|" + clientId + "|" + platform;
+  const days = snapshots && snapshots.days;
+  if (!days) return [];
+  return normalizePoints(Object.keys(days).map((date) => {
+    const row = days[date] && days[date][key];
+    if (!row) return null;
+    return {
