+
+function kstParts(date) {
+  const fmt = new Intl.DateTimeFormat("en-US", {
+    timeZone: "Asia/Seoul",
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+    hour: "2-digit",
+    minute: "2-digit",
+    weekday: "short",
+    hourCycle: "h23",
+  });
+  const parts = {};
+  fmt.formatToParts(date).forEach((part) => {
+    parts[part.type] = part.value;
+  });
+  const weekday = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 }[parts.weekday];
+  return {
+    year: Number(parts.year),
+    month: Number(parts.month),
+    day: Number(parts.day),
+    hour: Number(parts.hour),
+    minute: Number(parts.minute),
+    weekday,
+  };
+}
+
+function kstStamp(year, month, day, hour, minute) {
+  const pad = (n) => String(n).padStart(2, "0");
+  return new Date(year + "-" + pad(month) + "-" + pad(day) + "T" + pad(hour) + ":" + pad(minute) + ":00+09:00");
+}
+
+function nextRun(now, schedule) {
+  const spec = schedule || {};
+  const hour = Math.min(23, Math.max(0, Number(spec.hour) || 0));
+  const minute = Math.min(59, Math.max(0, Number(spec.minute) || 0));
+  const parts = kstParts(now);
+  if (spec.type === "monthly") {
+    let year = parts.year;
+    let month = parts.month;
+    let when = kstStamp(year, month, 1, hour, minute);
+    if (when.getTime() <= now.getTime()) {
+      month += 1;
+      if (month > 12) {
+        month = 1;
+        year += 1;
+      }
+      when = kstStamp(year, month, 1, hour, minute);
+    }
+    return when;
+  }
+  const weekday = Math.min(6, Math.max(0, Number(spec.weekday) || 0));
+  let delta = (weekday - parts.weekday + 7) % 7;
+  let when = kstStamp(parts.year, parts.month, parts.day, hour, minute);
+  when = new Date(when.getTime() + delta * 86400000);
+  if (when.getTime() <= now.getTime()) when = new Date(when.getTime() + 7 * 86400000);
+  return when;
+}
+
+function slotKey(clientId, schedule, now) {
+  const parts = kstParts(now);
+  if ((schedule || {}).type === "monthly") {
+    return clientId + ":monthly:" + parts.year + "-" + String(parts.month).padStart(2, "0");
+  }
+  const weekday = Number((schedule || {}).weekday) || 0;
+  const hour = Number((schedule || {}).hour) || 0;
+  return clientId + ":weekly:" + parts.year + "-" + String(parts.month).padStart(2, "0") + "-" + String(parts.day).padStart(2, "0") + ":" + weekday + ":" + hour;
+}
+
+function periodLabel(schedule, now) {
