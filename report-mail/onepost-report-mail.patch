+const fs = require("fs");
+const os = require("os");
+const path = require("path");
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const express = require("express");
+const { createReportMail, fillTemplate, nextRun, validEmail, mountReportMail, mailEnabled, buildWeekly, renderEmail, renderViewPage } = require("../lib/report-mail");
+
+function harness(now) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "report-mail-"));
+  const sent = [];
+  const mail = createReportMail({
+    file: path.join(dir, "mail.json"),
+    now: () => now,
+    publicBase: "https://1post.kr",
+    transport: { send: async (message) => sent.push(message) },
+  });
+  return { mail, sent };
+}
+
+const report = {
+  channels: [
+    { name: "유튜브", state: "ok", stateLabel: "확인된 값", stats: [{ label: "구독자", value: 10 }] },
+    { name: "페이스북", state: "disconnected", stateLabel: "연결 안 됨", stats: [] },
+  ],
+};
+
+test("template fills client, period, and channel count only", () => {
+  assert.equal(fillTemplate("안녕 {고객명} {기간} 채널 {채널수}", { clientName: "김밥천국", period: "2026년 11월", channelCount: 2 }), "안녕 김밥천국 2026년 11월 채널 2");
+  assert.equal(validEmail("ether@1post.kr"), true);
+  assert.equal(validEmail("bad\nether@1post.kr"), false);
+  assert.equal(validEmail("not-an-email"), false);
+  const { mail } = harness(new Date("2026-11-12T00:00:00.000Z"));
+  assert.throws(() => mail.saveSettings("shop", { fromEmail: "ether@1post.kr", to: ["not-an-email"] }), /받는 메일 주소를 확인해 주세요/);
+});
+
+test("weekly schedule lands on the next selected KST weekday", () => {
+  const now = new Date("2026-11-12T01:00:00.000Z");
+  const next = nextRun(now, { type: "weekly", weekday: 1, hour: 9, minute: 0 });
+  assert.equal(next.toISOString(), "2026-11-16T00:00:00.000Z");
+  const sunday = nextRun(new Date("2026-11-12T00:00:00.000Z"), { type: "weekly", weekday: 0, hour: 0, minute: 0 });
+  assert.equal(sunday.toISOString(), "2026-11-14T15:00:00.000Z");
+  const month = nextRun(new Date("2026-11-12T00:00:00.000Z"), { type: "monthly", hour: 9, minute: 0 });
+  assert.equal(month.toISOString(), "2026-12-01T00:00:00.000Z");
+});
+
+test("a scheduled slot is sent once even if the scheduler runs twice", async () => {
+  const { mail, sent } = harness(new Date("2026-11-09T00:05:00.000Z"));
+  mail.saveSettings("shop", {
+    fromName: "에테르",
+    fromEmail: "ether@1post.kr",
+    to: ["client@example.test"],
+    enabled: true,
+    include: "both",
+    schedule: { type: "weekly", weekday: 1, hour: 9, minute: 0 },
+    subject: "{고객명} {기간}",
+    body: "{고객명} 채널 {채널수}",
+  });
+  const load = async () => ({ report, clientName: "김밥천국", weeklyText: "주간 리포트 데이터가 없습니다." });
+  await mail.runScheduler(load);
+  await mail.runScheduler(load);
+  assert.equal(sent.length, 1);
+  assert.equal(sent[0].subject.includes("김밥천국"), true);
+  assert.equal(sent[0].html.includes("연결 안 됨"), true);
+  assert.equal(sent[0].html.includes("999"), false);
+});
+
+function dayValues(start, days, views) {
+  const out = [];
+  let cursor = start;
+  for (let i = 0; i < days; i += 1) {
+    out.push({ date: cursor, dayViews: views, followers: 100 + i, posts: 10 + i });
+    const [year, month, day] = cursor.split("-").map(Number);
+    cursor = new Date(Date.UTC(year, month - 1, day + 1)).toISOString().slice(0, 10);
+  }
+  return out;
+}
+
+test("weekly uses only complete 7-day windows and skips missing channels", () => {
+  const now = new Date("2026-11-12T03:00:00.000Z");
+  const weekly = buildWeekly({
+    now,
+    channels: [
+      {
+        id: "youtube",
+        connected: true,
+        points: [
+          { date: "2026-10-29", views: 1000, followers: 100, posts: 10 },
+          { date: "2026-11-05", views: 1100, followers: 110, posts: 12 },
+          { date: "2026-11-12", views: 1250, followers: 108, posts: 14 },
+        ],
+      },
+      {
+        id: "instagram",
+        connected: true,
+        points: dayValues("2026-10-30", 7, 10).concat(dayValues("2026-11-06", 7, 20)),
+      },
+      { id: "facebook", connected: false },
+      { id: "threads", connected: true, points: [{ date: "2026-11-12", followers: 3, posts: 1, dayViews: 5 }] },
+      { id: "tiktok", connected: true, points: [{ date: "2026-10-29", views: 10 }, { date: "2026-11-12", views: 40 }] },
+    ],
+  });
+  const youtube = weekly.channels.find((item) => item.id === "youtube");
+  assert.equal(youtube.metrics.views.current, 150);
+  assert.equal(youtube.metrics.views.previous, 100);
+  assert.equal(youtube.metrics.views.change, 50);
+  assert.equal(youtube.metrics.followers.current, -2);
+  assert.equal(youtube.metrics.followers.change, -120);
+  assert.equal(youtube.metrics.posts.current, 2);
+  assert.equal(youtube.metrics.posts.previous, 2);
+  assert.equal(youtube.metrics.posts.change, 0);
+  const instagram = weekly.channels.find((item) => item.id === "instagram");
+  assert.equal(instagram.metrics.views.current, 140);
+  assert.equal(instagram.metrics.views.previous, 70);
