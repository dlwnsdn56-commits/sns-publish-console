--- a/test/home-channels.test.js
+++ b/test/home-channels.test.js
@@ -0,0 +1,24 @@
+const fs = require("fs");
+const path = require("path");
+const test = require("node:test");
+const assert = require("node:assert/strict");
+
+const index = fs.readFileSync(path.join(__dirname, "..", "public", "index.html"), "utf8");
+const app = fs.readFileSync(path.join(__dirname, "..", "public", "app.js"), "utf8");
+const css = fs.readFileSync(path.join(__dirname, "..", "public", "styles.css"), "utf8");
+
+test("home channel grid hides Google Blog and keeps the other seven channels", () => {
+  const home = index.split('id="home-tiles"')[1].split("</section>")[0];
+  const tiles = [...home.matchAll(/<div class="tile"[^>]*data-sns="([^"]+)"([^>]*)>/g)];
+  const visible = tiles.filter((item) => !/\shidden\b/.test(item[2])).map((item) => item[1]);
+  assert.deepEqual(visible, ["youtube", "instagram", "facebook", "threads", "tiktok", "x", "naver-clip", "video"]);
+  const blogger = tiles.find((item) => item[1] === "blogger");
+  assert.equal(/\shidden\b/.test(blogger[2]), true);
+  assert.equal(css.includes('.tile[data-sns="blogger"]'), true);
+  assert.equal(css.includes("display: none !important"), true);
+  const tab = index.match(/<a class="chrome-tab"[^>]*data-sns="blogger"[^>]*>/);
+  assert.equal(tab && /\shidden\b/.test(tab[0]), true);
+  assert.equal(app.includes('if (s.id === "blogger") return;'), true);
+  assert.equal(app.includes('id: "blogger"'), true);
+  assert.equal(app.includes("/api/blogger/status"), true);
+});
