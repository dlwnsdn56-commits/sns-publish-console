--- a/test/agency-price.test.js
+++ b/test/agency-price.test.js
@@ -0,0 +1,36 @@
+const fs = require("fs");
+const path = require("path");
+const test = require("node:test");
+const assert = require("node:assert/strict");
+
+const root = path.join(__dirname, "..", "public");
+const phrase = "영상 제작 대행 월 10편 80만원 (VAT 별도) · 월 구독";
+const files = ["index.html", "ether.html", "agency.html"].map((name) => ({
+  name,
+  text: fs.readFileSync(path.join(root, name), "utf8"),
+}));
+
+test("agency price uses the confirmed monthly line and drops the prepaid pack", () => {
+  for (const file of files) {
+    assert.equal(file.text.includes(phrase), true, file.name);
+    for (const old of ["10편 충전", "충전식", "6개월 안에", "6개월 사용", "800,000원", "재충전"]) {
+      assert.equal(file.text.includes(old), false, file.name + " " + old);
+    }
+  }
+});
+
+test("OnePost tool price stays 9,900 and incentive copy is not invented", () => {
+  const index = files[0].text;
+  const ether = files[1].text;
+  const agency = files[2].text;
+  assert.equal(index.includes("월 9,900원"), true);
+  assert.equal(index.includes("₩9,900/30일"), true);
+  assert.equal(ether.includes("월 9,900원"), true);
+  assert.equal(agency.includes("월 9,900원"), true);
+  assert.equal(index.includes("최근 6개월 · 업로드 성공"), true);
+  for (const file of files) {
+    assert.equal(file.text.includes("인센티브 안내는 준비 중"), false);
+    assert.equal(file.text.includes("+10만"), false);
+    assert.equal(file.text.includes("1년 안"), false);
+  }
+});
