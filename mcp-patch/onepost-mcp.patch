+const crypto = require("crypto");
+
+function normalizeChannelId(id) {
+  const s = String(id || "").trim().toLowerCase();
+  if (s === "twitter") return "x";
+  return s;
+}
+
+function channelsIncludeX(channelIds) {
+  return (Array.isArray(channelIds) ? channelIds : []).some(
+    (id) => normalizeChannelId(id) === "x"
+  );
+}
+
+function flag(value) {
+  const raw = String(value == null ? "" : value).trim().toLowerCase();
+  return raw === "1" || raw === "true" || raw === "on" || value === true;
+}
+
+function parseObjectMap(raw, mapValue) {
+  if (raw == null || String(raw).trim() === "") return null;
+  let parsed = raw;
+  if (typeof raw === "string") {
+    try {
+      parsed = JSON.parse(raw);
+    } catch {
+      return null;
+    }
+  }
+  if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) return null;
+  const out = {};
+  for (const [key, value] of Object.entries(parsed)) {
+    const mapped = mapValue(value);
+    if (mapped === undefined) continue;
+    out[String(key)] = mapped;
+  }
+  return out;
+}
+
+/**
+ * Same checks as the console upload. Does not call a provider.
+ * ctx.files are already stored uploads: { originalName, storedName, mimeType, size }.
+ */
+function createPublishJob(ctx, deps) {
+  const body = (ctx && ctx.body) || {};
+  const email = String((ctx && ctx.email) || "").trim().toLowerCase();
+  const client = deps.getClient(email, String(body.clientId || ""));
+  if (!client) {
+    return { ok: false, status: 400, body: { error: "클라이언트를 선택하세요." } };
+  }
+
+  const mediaType = String(body.mediaType || "");
+  if (mediaType !== "video" && mediaType !== "images") {
+    return { ok: false, status: 400, body: { error: "미디어 유형을 선택하세요. (영상 또는 카드뉴스)" } };
+  }
+
+  const caption = String(body.caption || "");
+  const title = String(body.title || "").trim().slice(0, 100);
+  const scheduledAt = body.scheduledAt ? String(body.scheduledAt).trim() || null : null;
+  if (scheduledAt) {
+    const when = deps.store.parseSeoulLocalDateTime(scheduledAt);
+    if (!when) {
+      return { ok: false, status: 400, body: { error: "예약 시각 형식이 올바르지 않습니다." } };
+    }
+    if (deps.store.isScheduleTooFar(scheduledAt)) {
+      return {
+        ok: false,
+        status: 400,
+        body: {
+          error: "예약은 지금부터 최대 3일 이내만 가능합니다. (한국 시간 기준)",
+          code: "SCHEDULE_TOO_FAR",
+        },
+      };
+    }
+  }
+
+  const privatePost = flag(body.privatePost);
+  const aiGenerated = flag(body.aiGenerated);
+  const youtubeMadeForKids = flag(body.youtubeMadeForKids);
+  const youtubePaidPromotion = flag(body.youtubePaidPromotion);
+  const aiGeneratedByChannel = parseObjectMap(body.aiGeneratedByChannel, (value) => flag(value));
+  const captionsByChannel = parseObjectMap(body.captionsByChannel, (value) => {
+    if (value == null) return undefined;
+    return String(value);
+  });
+
+  let tiktokOptions = null;
+  if (body.tiktokOptions != null && String(body.tiktokOptions).trim() !== "") {
+    let parsed = body.tiktokOptions;
+    if (typeof parsed === "string") {
+      try {
+        parsed = JSON.parse(parsed);
+      } catch {
+        parsed = null;
+      }
+    }
+    if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) {
+      tiktokOptions = {
+        privacyLevel: String(parsed.privacyLevel || "").trim(),
+        allowComment: Boolean(parsed.allowComment),
+        allowDuet: Boolean(parsed.allowDuet),
+        allowStitch: Boolean(parsed.allowStitch),
+        commercialToggle: Boolean(parsed.commercialToggle),
+        yourBrand: Boolean(parsed.yourBrand),
+        brandedContent: Boolean(parsed.brandedContent),
+        videoDurationSec: Number(parsed.videoDurationSec) > 0 ? Number(parsed.videoDurationSec) : 0,
+      };
+    }
+  }
+
+  let channelIds = body.channels || [];
+  if (typeof channelIds === "string") {
+    try {
+      channelIds = JSON.parse(channelIds);
+    } catch {
+      channelIds = channelIds.split(",").map((s) => s.trim()).filter(Boolean);
+    }
+  }
+  if (!Array.isArray(channelIds) || channelIds.length === 0) {
+    return { ok: false, status: 400, body: { error: "채널을 하나 이상 선택하세요." } };
+  }
+
+  const planInfo = deps.resolvePlan(email);
+  if (!planInfo.isPaid && channelsIncludeX(channelIds)) {
+    return {
+      ok: false,
+      status: 403,
+      body: {
+        error: "무료 요금제에서는 X(트위터) 발행을 쓸 수 없습니다.",
+        code: "X_NOT_ALLOWED",
+        planId: planInfo.planId,
+        hint: "/pricing",
+      },
+    };
+  }
+  if (!planInfo.isPaid && planInfo.usedThisMonth >= planInfo.freeLimit) {
+    return {
+      ok: false,
+      status: 402,
+      body: {
+        error: "무료 요금제는 이번 달 10회까지입니다. 요금제에서 스타터로 올려 주세요.",
+        code: "FREE_LIMIT",
+        planId: planInfo.planId,
+        freeLimit: planInfo.freeLimit,
+        usedThisMonth: planInfo.usedThisMonth,
+        remainingThisMonth: 0,
+        hint: "/billing",
+      },
+    };
+  }
+
+  const files = Array.isArray(ctx.files) ? ctx.files : [];
+  if (files.length === 0) {
+    return { ok: false, status: 400, body: { error: "영상 1개 또는 이미지(카드뉴스)를 첨부하세요." } };
+  }
+  if (mediaType === "video") {
+    if (files.length !== 1) {
+      return { ok: false, status: 400, body: { error: "영상은 파일 1개만 첨부하세요." } };
+    }
+    const mime = files[0].mimeType || "";
+    if (!mime.startsWith("video/") && !/\.(mp4|mov|webm|mkv|m4v)$/i.test(files[0].originalName || "")) {
+      return { ok: false, status: 400, body: { error: "영상 파일을 첨부하세요." } };
