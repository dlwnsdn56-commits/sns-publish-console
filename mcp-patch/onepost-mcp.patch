+const { CHANNELS } = require("./channels");
+
+const NOTES = {
+  youtube: "연결되어 있어도 이 가게의 첫 영상은 기존 규칙대로 일부 공개로 올라갑니다.",
+  tiktok: "영상만 발행할 수 있습니다. 초안에 공개 범위가 있어야 합니다.",
+  x: "무료 요금제에서는 발행 승인이 거절됩니다.",
+  "naver-clip": "MCP에서는 발행할 수 없습니다. 윈도우 앱에서만 발행합니다.",
+  "naver-blog": "자동 발행이 아니라 수동 대기로 들어갑니다.",
+  "youtube-community": "API 즉시 발행이 아니라 기존 매크로 대기로 들어갑니다.",
+};
+
+function labelFrom(status) {
+  if (!status || typeof status !== "object") return null;
+  return (
+    status.channelTitle ||
+    status.username ||
+    status.pageName ||
+    status.blogTitle ||
+    status.displayName ||
+    null
+  );
+}
+
+function buildChannelStatus(stores) {
+  return function channelStatus(email, clientId) {
+    return CHANNELS.map((channel) => {
+      const reader = stores[channel.id];
+      let connected = false;
+      let label = null;
+      if (channel.id === "naver-clip") {
+        return {
+          id: channel.id,
+          name: channel.name,
+          kind: channel.kind,
+          connected: false,
+          available: false,
+          label: null,
+          note: NOTES[channel.id],
+        };
+      }
+      if (typeof reader === "function") {
+        try {
+          const status = reader(email, clientId) || {};
+          connected = status.connected === true;
+          label = labelFrom(status);
+        } catch (_err) {
+          connected = false;
+        }
+      }
+      return {
+        id: channel.id,
+        name: channel.name,
+        kind: channel.kind,
+        connected,
+        available: true,
+        label,
+        note: NOTES[channel.id] || "",
+      };
+    });
+  };
+}
+
+module.exports = { buildChannelStatus, NOTES };
