+    const canonical = {
+      version: draft.version,
+      clientId: draft.clientId,
+      mediaType: draft.mediaType,
+      title: draft.title,
+      caption: draft.caption,
+      channels: draft.channels,
+      uploadIds: draft.uploadIds,
+      scheduledAt: draft.scheduledAt,
+      privatePost: !!draft.privatePost,
+      aiGenerated: !!draft.aiGenerated,
+      aiGeneratedByChannel: draft.aiGeneratedByChannel,
+      captionsByChannel: draft.captionsByChannel,
+      youtubeMadeForKids: !!draft.youtubeMadeForKids,
+      youtubePaidPromotion: !!draft.youtubePaidPromotion,
