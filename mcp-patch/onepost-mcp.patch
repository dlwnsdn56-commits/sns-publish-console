+function rpc(port, { method, params, id = 1, token, origin, cookie }) {
+  const payload = { jsonrpc: "2.0", method };
+  if (id !== undefined) payload.id = id;
+  if (params !== undefined) payload.params = params;
+  return request(port, "POST", "/mcp", JSON.stringify(payload), {
+    "content-type": "application/json",
+    authorization: token ? "Bearer " + token : "",
+    origin: origin || "",
+    cookie: cookie || "",
+  });
+}
+
+function request(port, method, urlPath, body, headers) {
+  return new Promise((resolve, reject) => {
+    const buf = Buffer.from(body || "");
+    const head = Object.assign({ "content-length": buf.length }, headers || {});
+    for (const key of Object.keys(head)) if (!head[key]) delete head[key];
+    const req = http.request({ host: "127.0.0.1", port, path: urlPath, method, headers: head }, (res) => {
+      const chunks = [];
+      res.on("data", (chunk) => chunks.push(chunk));
+      res.on("end", () => {
+        const text = Buffer.concat(chunks).toString("utf8");
+        let json = null;
+        try { json = text ? JSON.parse(text) : null; } catch (_err) { json = null; }
+        resolve({ status: res.statusCode, json, text });
+      });
+    });
+    req.on("error", reject);
+    req.end(buf);
+  });
+}
+
+async function boot(options) {
