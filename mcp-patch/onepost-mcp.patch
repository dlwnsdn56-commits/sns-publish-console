+    const ttl = Math.min(Math.max(Number(input.ttlMs) || TOKEN_TTL_DEFAULT_MS, 60 * 60 * 1000), TOKEN_TTL_MAX_MS);
+    const secret = "opm_" + crypto.randomBytes(32).toString("base64url");
+    const row = {
+      id: crypto.randomUUID(),
+      hash: hashToken(secret),
+      email: String(input.email || "").trim().toLowerCase(),
+      name: String(input.name || "AI 연결").trim().slice(0, 80) || "AI 연결",
+      scopes,
+      clientId: input.clientId ? String(input.clientId) : null,
+      createdAt: nowIso(),
+      expiresAt: new Date(nowMs() + ttl).toISOString(),
+      revokedAt: null,
