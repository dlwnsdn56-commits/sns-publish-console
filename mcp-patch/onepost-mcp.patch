+      { id: "store-b", name: "가게B" },
+    ],
+    "other@example.test": [{ id: "store-c", name: "가게C" }],
+  };
+  const plan = opts.plan || { isPaid: true, planId: "starter", freeLimit: 10, usedThisMonth: 0 };
+  const mcpStore = createMcpStore({ dir, now: opts.now || (() => new Date("2026-11-07T01:00:00.000Z")) });
+  const app = express();
+  app.use(express.json({ limit: "32kb" }));
+  app.use(express.urlencoded({ extended: false }));
