diff -u -r -N a/test/youtube-options.test.js b/test/youtube-options.test.js
--- a/test/youtube-options.test.js	1970-01-01 00:00:00.000000000 +0000
+++ b/test/youtube-options.test.js	2026-11-13 05:46:01.372039522 +0000
@@ -0,0 +1,94 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const { buildYoutubeUpload, normalizeTags, TITLE_LIMIT } = require("../lib/youtube-options");
+const { createPublishJob } = require("../lib/publish-job");
+
+test("shorts title keeps #shorts inside 100 chars and description has one", () => {
+  const upload = buildYoutubeUpload({
+    title: "맛집 브이로그",
+    description: "오늘 영상",
+    durationSec: 45,
+    tags: "김치, 서울, 브이로그, 네번째",
+    youtubeSynthetic: false,
+  });
+  assert.equal(upload.title.endsWith("#shorts"), true);
+  assert.equal(upload.title.includes("#김치"), true);
+  assert.equal(upload.title.includes("#서울"), true);
+  assert.equal(upload.title.includes("#브이로그"), true);
+  assert.equal(upload.title.includes("#네번째"), false);
+  assert.equal(upload.title.length <= TITLE_LIMIT, true);
+  assert.equal((upload.description.match(/#shorts/gi) || []).length, 1);
+  assert.equal(upload.description.endsWith("#shorts"), true);
+  assert.equal(upload.containsSyntheticMedia, false);
+  assert.deepEqual(upload.tags.slice(0, 4), ["김치", "서울", "브이로그", "네번째"]);
+});
+
+test("long shorts title is trimmed but #shorts stays", () => {
+  const upload = buildYoutubeUpload({
+    title: "가".repeat(100),
+    description: "설명 #shorts 중간",
+    durationSec: 60,
+    tags: "태그",
+  });
+  assert.equal(upload.title.length <= 100, true);
+  assert.equal(upload.title.endsWith("#shorts"), true);
+  assert.equal(upload.title.includes("#태그"), false);
+  assert.equal((upload.description.match(/#shorts/gi) || []).length, 1);
+  assert.equal(upload.description.endsWith("#shorts"), true);
+});
+
+test("tags stay out of the title when they do not fit and synthetic is opt-in", () => {
+  const tags = "가".repeat(200) + ",나".repeat(200) + ",다";
+  assert.equal(normalizeTags(tags).join(",").length <= 500, true);
+  const plain = buildYoutubeUpload({
+    title: "일반 영상",
+    description: "설명 #shorts",
+    durationSec: 90,
+    tags: "한식",
+    youtubeSynthetic: true,
+  });
+  assert.equal(plain.title.includes("#shorts"), false);
+  assert.equal(plain.title.includes("#한식"), true);
+  assert.equal(plain.description, "설명 #shorts");
+  assert.equal(plain.containsSyntheticMedia, true);
+  const off = buildYoutubeUpload({ title: "일반", durationSec: 10 });
+  assert.equal(off.containsSyntheticMedia, false);
+  assert.equal(off.title.endsWith("#shorts"), true);
+});
+
+test("publish job keeps synthetic media off unless the upload asks for it", () => {
+  const deps = {
+    getClient: () => ({ id: "shop", name: "가게" }),
+    getChannel: (id) => ({ id, name: id, kind: "api" }),
+    isRpaKind: () => false,
+    resolvePlan: () => ({ isPaid: true, usedThisMonth: 0, freeLimit: 10, planId: "starter" }),
+    store: {
+      parseSeoulLocalDateTime: () => null,
+      isScheduleTooFar: () => false,
+      isFutureSeoulLocal: () => false,
+      addJob: () => null,
+      RPA_STATUS_QUEUED: "대기",
+    },
+  };
+  const files = [{ originalName: "a.mp4", storedName: "a.mp4", mimeType: "video/mp4", size: 10 }];
+  const off = createPublishJob({
+    email: "owner@example.test",
+    dryRun: true,
+    body: { clientId: "shop", mediaType: "video", channels: ["youtube"], title: "맛집", caption: "설명", youtubeTags: "김치", youtubeDurationSec: 20 },
+    files,
+  }, deps);
+  const task = off.tasks[0];
+  assert.equal(off.job.youtubeSynthetic, false);
+  assert.equal(task.youtubeSynthetic, false);
+  assert.equal(task.youtubeTitle.endsWith("#shorts"), true);
+  assert.equal(task.caption.endsWith("#shorts"), true);
+  assert.deepEqual(task.youtubeTags, ["김치"]);
+  const on = createPublishJob({
+    email: "owner@example.test",
+    dryRun: true,
+    body: { clientId: "shop", mediaType: "video", channels: ["youtube"], title: "맛집", caption: "설명", youtubeSynthetic: "1", youtubeDurationSec: 20 },
+    files,
+  }, deps);
+  assert.equal(on.job.youtubeSynthetic, true);
+  assert.equal(on.tasks[0].youtubeSynthetic, true);
+});
