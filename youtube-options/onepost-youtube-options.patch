diff -u -r -N a/lib/youtube-options.js b/lib/youtube-options.js
--- a/lib/youtube-options.js	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/youtube-options.js	2026-11-13 05:46:01.372039522 +0000
@@ -0,0 +1,80 @@
+const TITLE_LIMIT = 100;
+const TAGS_LIMIT = 500;
+const SHORTS_MARK = "#shorts";
+
+function normalizeTags(raw) {
+  const parts = Array.isArray(raw) ? raw : String(raw || "").split(/[,，]/);
+  const tags = [];
+  let total = 0;
+  parts.forEach((part) => {
+    const tag = String(part || "").trim().replace(/^#+/, "");
+    if (!tag || tags.some((item) => item.toLowerCase() === tag.toLowerCase())) return;
+    const extra = (tags.length ? 1 : 0) + tag.length;
+    if (total + extra > TAGS_LIMIT) return;
+    tags.push(tag);
+    total += extra;
+  });
+  return tags;
+}
+
+function isYoutubeShort(input) {
+  const seconds = Number(input && input.durationSec);
+  return Number.isFinite(seconds) && seconds > 0 && seconds <= 60;
+}
+
+function buildYoutubeTitle(input) {
+  const source = input || {};
+  const shorts = isYoutubeShort(source);
+  let base = String(source.title || "").replace(/\s+/g, " ").trim();
+  const already = /#shorts\b/i.test(base);
+  const needShorts = shorts && !already;
+  const reserved = needShorts ? (" " + SHORTS_MARK).length : 0;
+  if (base.length + reserved > TITLE_LIMIT) {
+    base = base.slice(0, Math.max(0, TITLE_LIMIT - reserved)).trimEnd();
+  }
+  const hashes = normalizeTags(source.tags).slice(0, 3).map((tag) => "#" + tag.replace(/\s+/g, ""));
+  let out = base;
+  hashes.forEach((hash) => {
+    if (out.toLowerCase().includes(hash.toLowerCase())) return;
+    const candidate = (out ? out + " " : "") + hash;
+    if (candidate.length + reserved > TITLE_LIMIT) return;
+    out = candidate;
+  });
+  if (needShorts) out = (out ? out + " " : "") + SHORTS_MARK;
+  return out;
+}
+
+function buildYoutubeDescription(input) {
+  const source = input || {};
+  const original = String(source.description || "");
+  if (!isYoutubeShort(source)) return original;
+  const cleaned = original.replace(/[ \t]*#shorts\b/gi, "").replace(/[ \t]+\n/g, "\n").trim();
+  return cleaned ? cleaned + "\n" + SHORTS_MARK : SHORTS_MARK;
+}
+
+function buildYoutubeUpload(input) {
+  const source = input || {};
+  const tags = normalizeTags(source.tags != null ? source.tags : source.youtubeTags);
+  const payload = {
+    title: source.title,
+    description: source.description != null ? source.description : source.caption,
+    tags,
+    durationSec: source.durationSec != null ? source.durationSec : source.youtubeDurationSec,
+  };
+  return {
+    title: buildYoutubeTitle(payload),
+    description: buildYoutubeDescription(payload),
+    tags,
+    containsSyntheticMedia: source.youtubeSynthetic === true || source.containsSyntheticMedia === true,
+  };
+}
+
+module.exports = {
+  TITLE_LIMIT,
+  TAGS_LIMIT,
+  normalizeTags,
+  isYoutubeShort,
+  buildYoutubeTitle,
+  buildYoutubeDescription,
+  buildYoutubeUpload,
+};
